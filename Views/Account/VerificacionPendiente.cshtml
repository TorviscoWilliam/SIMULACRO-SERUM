@{
    ViewData["Title"] = "Verifica tu correo";
    Layout = null;
    var correo    = ViewBag.Correo as string ?? "";
    var reenviado = TempData["Reenviado"] != null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Simulacro SERUMS – Verifica tu correo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #1a2980 0%, #26d0ce 100%); min-height: 100vh; font-family: 'Inter', sans-serif; }
        .card { border-radius: 1.5rem; border: none; }
        .icon-circle {
            width: 90px; height: 90px; border-radius: 50%;
            background: linear-gradient(135deg, #198754, #20c997);
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.5rem;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center py-4">

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg">
                <div class="card-body p-5 text-center">

                    <div class="icon-circle">
                        <i class="bi bi-envelope-check-fill text-white" style="font-size:2.5rem"></i>
                    </div>

                    <h4 class="fw-bold mb-2">Revisa tu correo</h4>
                    <p class="text-muted mb-1">Enviamos un enlace de verificación a:</p>
                    <p class="fw-semibold text-primary fs-5 mb-4">@correo</p>

                    <div class="alert alert-info text-start small py-2 mb-4">
                        <i class="bi bi-info-circle me-1"></i>
                        Haz clic en el enlace del correo para activar tu cuenta.
                        Si no lo ves, revisa la carpeta de <strong>spam o correo no deseado</strong>.
                    </div>

                    @if (reenviado)
                    {
                        <div class="alert alert-success small py-2 mb-3">
                            <i class="bi bi-check-circle me-1"></i>
                            ¡Correo reenviado exitosamente!
                        </div>
                    }

                    <p class="text-muted small mb-3">¿No recibiste el correo?</p>

                    <form asp-action="ReenviarVerificacion" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="correo" value="@correo"/>
                        <button type="submit" class="btn btn-outline-primary w-100 mb-3">
                            <i class="bi bi-send me-2"></i>Reenviar correo de verificación
                        </button>
                    </form>

                    <a asp-action="Login" class="text-muted small text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
                    </a>
                </div>

                <div class="card-footer text-center py-3 bg-transparent border-0">
                    <div class="text-muted small">&copy; @DateTime.Now.Year Simulacro SERUMS</div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
