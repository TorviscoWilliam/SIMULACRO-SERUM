@model RegisterViewModel
@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = null;
    var tiposExamen = (List<SimulacroExamen.Models.TipoExamen>)(ViewBag.TiposExamen ?? new List<SimulacroExamen.Models.TipoExamen>());
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Simulacro SERUMS – Crear Cuenta</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <style>
        body { background: linear-gradient(135deg, #1a2980 0%, #26d0ce 100%); min-height: 100vh; }
        .register-card { border-radius: 1.5rem; border: none; }
        .register-card .card-header {
            background: linear-gradient(135deg, #1a2980, #26d0ce);
            border-radius: 1.5rem 1.5rem 0 0;
            border: none;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center py-4">

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow-lg register-card">
                <div class="card-header py-4 text-center text-white">
                    <i class="bi bi-person-plus-fill" style="font-size:3rem"></i>
                    <h3 class="mt-2 fw-bold mb-0">Crear Cuenta</h3>
                    <p class="mb-0 opacity-75 small">Simulacro SERUMS</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <!-- Datos personales -->
                        <p class="fw-semibold text-muted small mb-2 text-uppercase letter-spacing-1">
                            <i class="bi bi-person-vcard me-1"></i>Datos Personales
                        </p>

                        <div class="row g-2 mb-2">
                            <div class="col-12 col-sm-6">
                                <label asp-for="PrimerNombre" class="form-label fw-semibold small"></label>
                                <input asp-for="PrimerNombre" id="primerNombre" class="form-control form-control-sm"
                                       placeholder="Ej: JUAN" autocomplete="given-name" />
                                <span asp-validation-for="PrimerNombre" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="SegundoNombre" class="form-label fw-semibold small"></label>
                                <input asp-for="SegundoNombre" class="form-control form-control-sm"
                                       placeholder="Opcional" autocomplete="additional-name" />
                                <span asp-validation-for="SegundoNombre" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="PrimerApellido" class="form-label fw-semibold small"></label>
                                <input asp-for="PrimerApellido" id="primerApellido" class="form-control form-control-sm"
                                       placeholder="Ej: PÉREZ" autocomplete="family-name" />
                                <span asp-validation-for="PrimerApellido" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="SegundoApellido" class="form-label fw-semibold small"></label>
                                <input asp-for="SegundoApellido" class="form-control form-control-sm"
                                       placeholder="Opcional" />
                                <span asp-validation-for="SegundoApellido" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="Celular" class="form-label fw-semibold small">
                                    Celular <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-phone"></i></span>
                                    <input asp-for="Celular" class="form-control"
                                           placeholder="Ej: 987654321" autocomplete="tel" />
                                    <span class="input-group-text px-2" id="feedCelularIcon"></span>
                                </div>
                                <span asp-validation-for="Celular" class="text-danger small"></span>
                                <div id="feedCelular" class="form-text small d-none"></div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="Dni" class="form-label fw-semibold small">
                                    DNI <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                                    <input asp-for="Dni" class="form-control"
                                           placeholder="8 dígitos" maxlength="8"
                                           inputmode="numeric" pattern="\d{8}" />
                                    <span class="input-group-text px-2" id="feedDniIcon"></span>
                                </div>
                                <span asp-validation-for="Dni" class="text-danger small"></span>
                                <div id="feedDni" class="form-text small d-none"></div>
                            </div>
                        </div>

                        <hr class="my-3"/>

                        <!-- Credenciales -->
                        <p class="fw-semibold text-muted small mb-2 text-uppercase">
                            <i class="bi bi-lock me-1"></i>Credenciales de Acceso
                        </p>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Nombre de Usuario</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input id="nombreUsuario" name="NombreUsuario" class="form-control bg-body-secondary"
                                       placeholder="Se genera al escribir tu nombre…" readonly tabindex="-1"/>
                            </div>
                            <div class="form-text small text-muted">
                                <i class="bi bi-magic me-1"></i>Se asigna automáticamente como <strong>Nombre.Apellido</strong>.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label fw-semibold small"></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Correo" class="form-control"
                                       placeholder="correo@ejemplo.com" autocomplete="email"/>
                                <span class="input-group-text px-2" id="feedCorreoIcon"></span>
                            </div>
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                            <div id="feedCorreo" class="form-text small d-none"></div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contrasena" class="form-label fw-semibold small"></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="Contrasena" class="form-control"
                                       placeholder="Mínimo 6 caracteres" autocomplete="new-password"/>
                                <button class="btn btn-outline-secondary" type="button" id="togglePass1">
                                    <i class="bi bi-eye" id="eye1"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Contrasena" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmarContrasena" class="form-label fw-semibold small"></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmarContrasena" class="form-control"
                                       placeholder="Repita la contraseña" autocomplete="new-password"/>
                                <button class="btn btn-outline-secondary" type="button" id="togglePass2">
                                    <i class="bi bi-eye" id="eye2"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                        </div>

                        <!-- Tipo de examen de prueba -->
                        <hr class="my-3"/>
                        <h6 class="fw-bold mb-3 text-primary">
                            <i class="bi bi-mortarboard me-2"></i>Elige tu Examen de Prueba
                        </h6>
                        <div class="mb-3">
                            <label asp-for="TipoExamenId" class="form-label fw-semibold small"></label>
                            <select asp-for="TipoExamenId" class="form-select form-select-sm">
                                <option value="">-- Selecciona un tipo de examen --</option>
                                @foreach (var tipo in tiposExamen)
                                {
                                    <option value="@tipo.Id">@tipo.Nombre</option>
                                }
                            </select>
                            <span asp-validation-for="TipoExamenId" class="text-danger small"></span>
                        </div>
                        <div class="alert alert-info py-2 small mb-3">
                            <i class="bi bi-info-circle me-1"></i>
                            Al registrarte tendrás acceso a <strong>1 examen de prueba de 20 preguntas</strong>.
                            Luego contacta al administrador para obtener acceso completo.
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                            <i class="bi bi-person-check me-2"></i>Registrarme
                        </button>
                    </form>
                </div>

                <div class="card-footer text-center py-3 bg-transparent">
                    <span class="text-muted small">¿Ya tienes cuenta?</span>
                    <a asp-action="Login" class="fw-semibold ms-1">Iniciar sesión</a>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ── Referencias ───────────────────────────────────────────────
    const inputPrimerNombre   = document.getElementById('primerNombre');
    const inputSegundoNombre  = document.querySelector('[name="SegundoNombre"]');
    const inputPrimerApellido = document.getElementById('primerApellido');
    const inputUsuario        = document.getElementById('nombreUsuario');
    const inputCorreo         = document.querySelector('[name="Correo"]');
    const inputCelular        = document.querySelector('[name="Celular"]');
    const inputDni            = document.querySelector('[name="Dni"]');

    // ── Utilidad: mostrar feedback bajo un campo ──────────────────
    function setFeed(feedId, iconId, estado, msg) {
        // estado: 'ok' | 'error' | 'reset'
        const feed = document.getElementById(feedId);
        const icon = document.getElementById(iconId);
        if (!feed || !icon) return;
        if (estado === 'reset') {
            feed.className = 'form-text small d-none';
            icon.innerHTML = '';
            return;
        }
        feed.className = 'form-text small ' + (estado === 'ok' ? 'text-success' : 'text-danger');
        feed.innerHTML = msg;
        feed.classList.remove('d-none');
        icon.innerHTML = estado === 'ok'
            ? '<i class="bi bi-check-circle-fill text-success"></i>'
            : '<i class="bi bi-x-circle-fill text-danger"></i>';
    }

    // ── AJAX: verificar disponibilidad ────────────────────────────
    async function verificar(campo, valor) {
        if (!valor) return null;
        try {
            const r = await fetch(`/Account/Verificar?campo=${campo}&valor=${encodeURIComponent(valor)}`);
            const d = await r.json();
            return d.ocupado;
        } catch { return null; }
    }

    // ── Auto-generar username (solo preview, el servidor lo confirma) ──
    function generarUsuario() {
        const n = (inputPrimerNombre.value || '').trim().split(/\s+/)[0].toUpperCase();
        const a = (inputPrimerApellido.value || '').trim().split(/\s+/)[0].toUpperCase();
        inputUsuario.value = (n && a) ? `${n}.${a}` : (n || a || '');
    }

    inputPrimerNombre.addEventListener('input', generarUsuario);
    inputPrimerApellido.addEventListener('input', generarUsuario);

    // ── Verificar correo ──────────────────────────────────────────
    inputCorreo.addEventListener('blur', async function () {
        const val = this.value.trim();
        if (!val) return;
        const ocupado = await verificar('correo', val);
        if (ocupado === null) return;
        ocupado
            ? setFeed('feedCorreo', 'feedCorreoIcon', 'error', 'Este correo ya está registrado.')
            : setFeed('feedCorreo', 'feedCorreoIcon', 'ok',    'Correo disponible.');
    });
    inputCorreo.addEventListener('input', () => setFeed('feedCorreo', 'feedCorreoIcon', 'reset', ''));

    // ── Verificar celular ─────────────────────────────────────────
    inputCelular.addEventListener('blur', async function () {
        const val = this.value.trim();
        if (!val) return;
        const ocupado = await verificar('celular', val);
        if (ocupado === null) return;
        ocupado
            ? setFeed('feedCelular', 'feedCelularIcon', 'error', 'Este celular ya está registrado.')
            : setFeed('feedCelular', 'feedCelularIcon', 'ok',    'Celular disponible.');
    });
    inputCelular.addEventListener('input', () => setFeed('feedCelular', 'feedCelularIcon', 'reset', ''));

    // ── Verificar DNI ─────────────────────────────────────────────
    inputDni.addEventListener('blur', async function () {
        const val = this.value.trim();
        if (val.length !== 8) return;
        const ocupado = await verificar('dni', val);
        if (ocupado === null) return;
        ocupado
            ? setFeed('feedDni', 'feedDniIcon', 'error', 'Este DNI ya está registrado.')
            : setFeed('feedDni', 'feedDniIcon', 'ok',    'DNI disponible.');
    });
    inputDni.addEventListener('input', () => setFeed('feedDni', 'feedDniIcon', 'reset', ''));

    // ── Toggle contraseña ─────────────────────────────────────────
    function togglePwd(btnId, eyeId, inputEl) {
        document.getElementById(btnId).addEventListener('click', function () {
            const icon = document.getElementById(eyeId);
            inputEl.type = inputEl.type === 'password' ? 'text' : 'password';
            icon.className = inputEl.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        });
    }
    togglePwd('togglePass1', 'eye1', document.getElementById('Contrasena'));
    togglePwd('togglePass2', 'eye2', document.getElementById('ConfirmarContrasena'));
</script>
</body>
</html>
