@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <i class="bi bi-exclamation-triangle text-danger" style="font-size:5rem"></i>
        <h2 class="mt-3">Ocurrió un error</h2>
        <p class="text-muted">Ha ocurrido un error inesperado. Intente nuevamente.</p>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house me-2"></i>Volver al inicio
            </a>
        }
        else if (User.IsInRole("Usuario"))
        {
            <a asp-controller="Examen" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house me-2"></i>Volver al inicio
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right me-2"></i>Ir al Login
            </a>
        }
    </div>
</div>
