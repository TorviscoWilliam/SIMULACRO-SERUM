@inject SimulacroExamen.Data.ApplicationDbContext _layoutDb
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Simulacro de Examen</title>

    <!-- Aplicar tema ANTES de renderizar para evitar flash -->
    <script>
        (function () {
            var t = localStorage.getItem('tema') || 'light';
            var bsTheme = t === 'dark' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', bsTheme);
            document.documentElement.setAttribute('data-tema', t);
        })();
    </script>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        bool isAuthenticated = User.Identity?.IsAuthenticated == true;
        bool isAdmin         = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
        int _sugerenciasNuevas = 0;
        if (isAdmin && isAuthenticated)
        {
            // try/catch defensivo: si la tabla aún no existe o hay cualquier
            // error de BD, el layout no debe tumbar la página entera.
            try
            {
                _sugerenciasNuevas = await _layoutDb.Sugerencias.CountAsync(s => !s.Leida);
            }
            catch { _sugerenciasNuevas = 0; }
        }
    }

    <!-- ── Navbar ─────────────────────────────────────────────── -->
    @if (isAuthenticated)
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid px-4">
                @if (isAdmin)
                {
                    <a class="navbar-brand fw-bold"
                       asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-journal-check me-2"></i>Simulacro SERUMS
                    </a>
                }
                else
                {
                    <a class="navbar-brand fw-bold"
                       asp-controller="Examen" asp-action="Index">
                        <i class="bi bi-journal-check me-2"></i>Simulacro SERUMS
                    </a>
                }

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav me-auto">

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="PanelFinanciero">
                                    <i class="bi bi-cash-coin me-1"></i>Finanzas
                                </a>
                            </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Usuarios">
                                    <i class="bi bi-people me-1"></i>Usuarios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Preguntas">
                                    <i class="bi bi-question-circle me-1"></i>Preguntas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="TiposExamen">
                                    <i class="bi bi-mortarboard me-1"></i>Tipos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Noticias">
                                    <i class="bi bi-megaphone me-1"></i>Noticias
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Planes">
                                    <i class="bi bi-star me-1"></i>Planes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="AnuncioGlobal">
                                    <i class="bi bi-broadcast me-1"></i>Anuncio
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="EstadisticasPreguntas">
                                    <i class="bi bi-bar-chart-line me-1"></i>Estadísticas
                                </a>
                            </li>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Logs">
                                    <i class="bi bi-journal-text me-1"></i>Logs
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="ParametrosGlobales">
                                    <i class="bi bi-sliders me-1"></i>Parámetros
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="ConfiguracionCorreo">
                                    <i class="bi bi-envelope-gear me-1"></i>Correo
                                </a>
                            </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-1"
                                   asp-controller="Admin" asp-action="Sugerencias">
                                    <i class="bi bi-chat-heart me-1"></i>Sugerencias
                                    @if (_sugerenciasNuevas > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill"
                                              style="font-size:.7rem">@_sugerenciasNuevas</span>
                                    }
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Examen" asp-action="Index">
                                    <i class="bi bi-house me-1"></i>Inicio
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Examen" asp-action="Historial">
                                    <i class="bi bi-clock-history me-1"></i>Mi Historial
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Examen" asp-action="Noticias">
                                    <i class="bi bi-megaphone me-1"></i>Noticias
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Examen" asp-action="Sugerencias">
                                    <i class="bi bi-chat-heart me-1"></i>Sugerencias
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Examen" asp-action="Configuracion">
                                    <i class="bi bi-gear me-1"></i>Configuración
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center gap-2">
                        <!-- Selector de tema / accesibilidad -->
                        <li class="nav-item dropdown">
                            <button id="btnTema" class="btn btn-sm btn-outline-light dropdown-toggle"
                                    title="Tema y accesibilidad" data-bs-toggle="dropdown" aria-expanded="false">
                                <i id="iconTema" class="bi bi-moon-stars-fill"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow" style="min-width:210px">
                                <li><h6 class="dropdown-header"><i class="bi bi-circle-half me-1"></i>Tema</h6></li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2" onclick="setTema('light')">
                                        <i class="bi bi-sun-fill text-warning"></i> Claro
                                        <i id="check-light" class="bi bi-check2 ms-auto"></i>
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2" onclick="setTema('dark')">
                                        <i class="bi bi-moon-stars-fill text-primary"></i> Oscuro
                                        <i id="check-dark" class="bi bi-check2 ms-auto d-none"></i>
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header"><i class="bi bi-eye me-1"></i>Daltonismo</h6></li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2" onclick="setTema('deuteranopia')">
                                        <span style="display:inline-block;width:14px;height:14px;border-radius:50%;background:linear-gradient(135deg,#f5a623,#4a90d9)"></span>
                                        Deuteranopia <small class="text-muted ms-1">rojo-verde</small>
                                        <i id="check-deuteranopia" class="bi bi-check2 ms-auto d-none"></i>
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2" onclick="setTema('protanopia')">
                                        <span style="display:inline-block;width:14px;height:14px;border-radius:50%;background:linear-gradient(135deg,#f0c040,#5b8dd9)"></span>
                                        Protanopia <small class="text-muted ms-1">rojo débil</small>
                                        <i id="check-protanopia" class="bi bi-check2 ms-auto d-none"></i>
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header"><i class="bi bi-circle me-1"></i>Contraste</h6></li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2" onclick="setTema('grises')">
                                        <span style="display:inline-block;width:14px;height:14px;border-radius:50%;background:linear-gradient(135deg,#aaa,#333)"></span>
                                        Escala de grises
                                        <i id="check-grises" class="bi bi-check2 ms-auto d-none"></i>
                                    </button>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                               href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span>@User.Identity!.Name</span>
                                @if (isAdmin)
                                {
                                    <span class="badge bg-warning text-dark">Admin</span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    }

    <!-- ── Contenido principal ────────────────────────────────── -->
    <main class="container-fluid px-4 py-4">

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <span>@TempData["Exito"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span>@TempData["Error"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Advertencia"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                <span>@TempData["Advertencia"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @{
            // Banner de anuncio global (mantenimiento u otro aviso del admin).
            // try/catch: si la tabla aún no existe en Azure no debe romper el render.
            SimulacroExamen.Models.AnuncioGlobal? _anuncioGlobal = null;
            try
            {
                _anuncioGlobal = await _layoutDb.AnunciosGlobales
                    .Where(a => a.Activo)
                    .FirstOrDefaultAsync();
            }
            catch { _anuncioGlobal = null; }
        }
        @if (_anuncioGlobal != null)
        {
            var iconoAnuncio = _anuncioGlobal.Tipo switch {
                "danger"  => "bi-exclamation-octagon-fill",
                "warning" => "bi-exclamation-triangle-fill",
                "success" => "bi-check-circle-fill",
                _         => "bi-info-circle-fill"
            };
            <div class="alert alert-@(_anuncioGlobal.Tipo) alert-dismissible d-flex align-items-center gap-3 mb-3 shadow-sm rounded-3" role="alert">
                <i class="bi @iconoAnuncio fs-5 flex-shrink-0"></i>
                <span class="flex-grow-1">@_anuncioGlobal.Mensaje</span>
                <button type="button" class="btn-close flex-shrink-0" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- ── Footer ─────────────────────────────────────────────── -->
    <footer class="footer border-top mt-auto py-3 text-center text-muted small">
        &copy; @DateTime.Now.Year – Simulacro de Examen SERUMS
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Filtros SVG para daltonismo (invisibles, solo definen los filtros CSS) -->
    <svg width="0" height="0" style="position:absolute;overflow:hidden" aria-hidden="true">
        <defs>
            <!-- Deuteranopia: déficit de fotorreceptores verdes (más común, ~6% varones) -->
            <filter id="svgf-deuteranopia">
                <feColorMatrix type="matrix" values="
                    0.625 0.375 0.000 0 0
                    0.700 0.300 0.000 0 0
                    0.000 0.300 0.700 0 0
                    0.000 0.000 0.000 1 0"/>
            </filter>
            <!-- Protanopia: déficit de fotorreceptores rojos -->
            <filter id="svgf-protanopia">
                <feColorMatrix type="matrix" values="
                    0.567 0.433 0.000 0 0
                    0.558 0.442 0.000 0 0
                    0.000 0.242 0.758 0 0
                    0.000 0.000 0.000 1 0"/>
            </filter>
        </defs>
    </svg>

    <!-- Selector de tema y accesibilidad -->
    <script>
        var _temas = ['light','dark','deuteranopia','protanopia','grises'];

        function setTema(tema) {
            var html = document.documentElement;
            localStorage.setItem('tema', tema);
            html.setAttribute('data-bs-theme', tema === 'dark' ? 'dark' : 'light');
            html.setAttribute('data-tema', tema);
            actualizarIconTema(tema);
            actualizarChecks(tema);
        }

        function actualizarIconTema(tema) {
            var icon = document.getElementById('iconTema');
            if (!icon) return;
            var iconos = {
                light:        'bi bi-sun-fill',
                dark:         'bi bi-moon-stars-fill',
                deuteranopia: 'bi bi-eye-fill',
                protanopia:   'bi bi-eye-fill',
                grises:       'bi bi-circle-half'
            };
            icon.className = iconos[tema] || 'bi bi-moon-stars-fill';
        }

        function actualizarChecks(tema) {
            _temas.forEach(function(t) {
                var el = document.getElementById('check-' + t);
                if (el) el.classList.toggle('d-none', t !== tema);
            });
        }

        // Aplicar al cargar
        (function () {
            var t = localStorage.getItem('tema') || 'light';
            actualizarIconTema(t);
            actualizarChecks(t);
        })();
    </script>
</body>
</html>
