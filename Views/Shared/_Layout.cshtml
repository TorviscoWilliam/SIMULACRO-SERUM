@inject SimulacroExamen.Data.ApplicationDbContext _layoutDb
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Simulacro de Examen</title>

    <!-- Aplicar tema ANTES de renderizar para evitar flash de pantalla blanca -->
    <script>
        (function () {
            var t = localStorage.getItem('tema') || 'light';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        bool isAuthenticated = User.Identity?.IsAuthenticated == true;
        bool isAdmin         = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
        int _sugerenciasNuevas = 0;
        if (isAdmin && isAuthenticated)
        {
            // try/catch defensivo: si la tabla aún no existe o hay cualquier
            // error de BD, el layout no debe tumbar la página entera.
            try
            {
                _sugerenciasNuevas = await _layoutDb.Sugerencias.CountAsync(s => !s.Leida);
            }
            catch { _sugerenciasNuevas = 0; }
        }
    }

    <!-- ── Navbar ─────────────────────────────────────────────── -->
    @if (isAuthenticated)
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid px-4">
                @if (isAdmin)
                {
                    <a class="navbar-brand fw-bold"
                       asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-journal-check me-2"></i>Simulacro SERUMS
                    </a>
                }
                else
                {
                    <a class="navbar-brand fw-bold"
                       asp-controller="Examen" asp-action="Index">
                        <i class="bi bi-journal-check me-2"></i>Simulacro SERUMS
                    </a>
                }

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav me-auto">

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Usuarios">
                                    <i class="bi bi-people me-1"></i>Usuarios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Preguntas">
                                    <i class="bi bi-question-circle me-1"></i>Preguntas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="TiposExamen">
                                    <i class="bi bi-mortarboard me-1"></i>Tipos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Noticias">
                                    <i class="bi bi-megaphone me-1"></i>Noticias
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Planes">
                                    <i class="bi bi-star me-1"></i>Planes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="AnuncioGlobal">
                                    <i class="bi bi-broadcast me-1"></i>Anuncio
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="EstadisticasPreguntas">
                                    <i class="bi bi-bar-chart-line me-1"></i>Estadísticas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Logs">
                                    <i class="bi bi-journal-text me-1"></i>Logs
                                </a>
                            </li>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="ConfiguracionCorreo">
                                    <i class="bi bi-envelope-gear me-1"></i>Correo
                                </a>
                            </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-1"
                                   asp-controller="Admin" asp-action="Sugerencias">
                                    <i class="bi bi-chat-heart me-1"></i>Sugerencias
                                    @if (_sugerenciasNuevas > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill"
                                              style="font-size:.7rem">@_sugerenciasNuevas</span>
                                    }
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Examen" asp-action="Index">
                                    <i class="bi bi-house me-1"></i>Inicio
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Examen" asp-action="Historial">
                                    <i class="bi bi-clock-history me-1"></i>Mi Historial
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Examen" asp-action="Noticias">
                                    <i class="bi bi-megaphone me-1"></i>Noticias
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Examen" asp-action="Sugerencias">
                                    <i class="bi bi-chat-heart me-1"></i>Sugerencias
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Examen" asp-action="Configuracion">
                                    <i class="bi bi-gear me-1"></i>Configuración
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center gap-2">
                        <!-- Botón modo oscuro -->
                        <li class="nav-item">
                            <button id="btnTema" class="btn btn-sm btn-outline-light"
                                    title="Cambiar tema" onclick="toggleTema()">
                                <i id="iconTema" class="bi bi-moon-stars-fill"></i>
                            </button>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                               href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span>@User.Identity!.Name</span>
                                @if (isAdmin)
                                {
                                    <span class="badge bg-warning text-dark">Admin</span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item text-danger"
                                       asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    }

    <!-- ── Contenido principal ────────────────────────────────── -->
    <main class="container-fluid px-4 py-4">

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <span>@TempData["Exito"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span>@TempData["Error"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Advertencia"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                <span>@TempData["Advertencia"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @{
            // Banner de anuncio global (mantenimiento u otro aviso del admin).
            // try/catch: si la tabla aún no existe en Azure no debe romper el render.
            SimulacroExamen.Models.AnuncioGlobal? _anuncioGlobal = null;
            try
            {
                _anuncioGlobal = await _layoutDb.AnunciosGlobales
                    .Where(a => a.Activo)
                    .FirstOrDefaultAsync();
            }
            catch { _anuncioGlobal = null; }
        }
        @if (_anuncioGlobal != null)
        {
            var iconoAnuncio = _anuncioGlobal.Tipo switch {
                "danger"  => "bi-exclamation-octagon-fill",
                "warning" => "bi-exclamation-triangle-fill",
                "success" => "bi-check-circle-fill",
                _         => "bi-info-circle-fill"
            };
            <div class="alert alert-@(_anuncioGlobal.Tipo) alert-dismissible d-flex align-items-center gap-3 mb-3 shadow-sm rounded-3" role="alert">
                <i class="bi @iconoAnuncio fs-5 flex-shrink-0"></i>
                <span class="flex-grow-1">@_anuncioGlobal.Mensaje</span>
                <button type="button" class="btn-close flex-shrink-0" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- ── Footer ─────────────────────────────────────────────── -->
    <footer class="footer border-top mt-auto py-3 text-center text-muted small">
        &copy; @DateTime.Now.Year – Simulacro de Examen SERUMS
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Modo oscuro -->
    <script>
        function toggleTema() {
            var html  = document.documentElement;
            var actual = html.getAttribute('data-bs-theme');
            var nuevo  = actual === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-bs-theme', nuevo);
            localStorage.setItem('tema', nuevo);
            actualizarIconTema(nuevo);
        }

        function actualizarIconTema(tema) {
            var icon = document.getElementById('iconTema');
            if (!icon) return;
            icon.className = tema === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
        }

        // Sincronizar ícono al cargar la página
        actualizarIconTema(localStorage.getItem('tema') || 'light');
    </script>
</body>
</html>
