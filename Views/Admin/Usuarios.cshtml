@model List<UsuarioListaViewModel>
@{
    ViewData["Title"] = "Usuarios";
    int page        = (int)ViewBag.Page;
    int totalPages  = (int)ViewBag.TotalPages;
    int totalItems  = (int)ViewBag.TotalItems;
    var currentUserId  = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
    var esSuperAdmin   = User.IsInRole("SuperAdmin");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Usuarios</h2>
        <p class="text-muted mb-0">@totalItems usuario(s) registrado(s)</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="ExportarUsuarios" class="btn btn-success">
            <i class="bi bi-file-earmark-excel me-2"></i>Exportar Excel
        </a>
        <a asp-action="DescargarPlantillaUsuarios" class="btn btn-outline-secondary">
            <i class="bi bi-download me-2"></i>Plantilla Excel
        </a>
        <button class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalImportarUsuarios">
            <i class="bi bi-upload me-2"></i>Importar Excel
        </button>
        <a asp-action="CrearUsuario" class="btn btn-primary">
            <i class="bi bi-person-plus me-2"></i>Nuevo Usuario
        </a>
    </div>
</div>

<!-- Búsqueda -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <input type="text" id="busqueda" class="form-control"
               placeholder="Buscar por usuario o correo...">
    </div>
</div>

<!-- Tabla -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="tablaUsuarios">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Usuario</th>
                    <th>Correo</th>
                    <th class="text-center">Rol</th>
                    <th>Tipos de Examen</th>
                    <th class="text-center">Exámenes</th>
                    <th class="text-center">Mejor Puntaje</th>
                    <th class="text-center">Límite/día</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr class="@(u.Activo ? "" : "table-secondary opacity-75")">
                        <td class="text-muted small">@u.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle bg-primary text-white">
                                    @u.NombreUsuario[0].ToString().ToUpper()
                                </div>
                                <div>
                                    <div class="fw-semibold">@u.NombreUsuario</div>
                                    @if (!string.IsNullOrEmpty(u.NombreCompleto))
                                    {
                                        <div class="text-muted small">@u.NombreCompleto</div>
                                    }
                                    <div class="text-muted small">@u.FechaCreacion.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                        </td>
                        <td class="text-muted small">
                            <div>@u.Correo</div>
                            @if (!string.IsNullOrEmpty(u.Celular))
                            {
                                <div><i class="bi bi-phone me-1"></i>@u.Celular</div>
                            }
                            @if (!string.IsNullOrEmpty(u.Dni))
                            {
                                <div><i class="bi bi-credit-card me-1"></i>@u.Dni</div>
                            }
                        </td>
                        <td class="text-center">
                            @if (u.Rol == "SuperAdmin")
                            {
                                <span class="badge bg-dark"><i class="bi bi-shield-shaded me-1"></i>SuperAdmin</span>
                            }
                            else if (u.Rol == "Admin")
                            {
                                <span class="badge bg-danger"><i class="bi bi-shield-fill me-1"></i>Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark"><i class="bi bi-mortarboard me-1"></i>Estudiante</span>
                            }
                        </td>
                        <td>
                            @if (u.Rol == "Admin")
                            {
                                <span class="text-muted small fst-italic">N/A</span>
                            }
                            else if (u.TiposAsignados.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var tipo in u.TiposAsignados)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle small">
                                            @tipo
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small"><i class="bi bi-exclamation-triangle me-1 text-warning"></i>Sin acceso</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3">
                                @u.TotalExamenes
                            </span>
                        </td>
                        <td class="text-center fw-bold">@u.MejorPuntaje</td>
                        <td class="text-center">
                            @if (u.Rol != "Admin")
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary btn-ajustar-intentos"
                                        data-id="@u.Id"
                                        data-nombre="@u.NombreUsuario"
                                        data-intentos="@u.IntentosExtra"
                                        title="Ajustar intentos diarios">
                                    <i class="bi bi-plus-slash-minus me-1"></i>@(5 + u.IntentosExtra)
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">N/A</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (u.Activo)
                            {
                                <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                            @if (u.EsTrial && u.Rol != "Admin")
                            {
                                <br/><span class="badge bg-warning text-dark mt-1">
                                    <i class="bi bi-hourglass-split me-1"></i>Trial
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-1 justify-content-center">
                                @if (esSuperAdmin || u.Rol != "SuperAdmin")
                                {
                                    <a asp-action="EditarUsuario" asp-route-id="@u.Id"
                                       class="btn btn-sm btn-outline-warning" title="Editar usuario">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                                @if (u.Rol != "Admin" && u.Rol != "SuperAdmin")
                                {
                                    <a asp-action="AsignarAcceso" asp-route-id="@u.Id"
                                       class="btn btn-sm btn-outline-info" title="Gestionar acceso">
                                        <i class="bi bi-key me-1"></i>Acceso
                                    </a>
                                }
                                @if (u.Rol != "Admin" && u.Rol != "SuperAdmin")
                                {
                                    @if (u.EsTrial)
                                    {
                                        <form asp-action="ActivarAccesoCompleto" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Activar acceso completo para @u.NombreUsuario?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id"/>
                                            <button type="submit" class="btn btn-sm btn-warning" title="Dar acceso completo">
                                                <i class="bi bi-unlock me-1"></i>Trial→Completo
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ActivarTrial" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Revertir a modo de prueba a @u.NombreUsuario?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id"/>
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Revertir a trial">
                                                <i class="bi bi-hourglass-split me-1"></i>Completo→Trial
                                            </button>
                                        </form>
                                    }
                                }
                                @if (u.Id != currentUserId && (esSuperAdmin || u.Rol != "SuperAdmin"))
                                {
                                    <form asp-action="ToggleUsuario" method="post"
                                          onsubmit="return confirm('@(u.Activo ? "¿Desactivar" : "¿Activar") al usuario @u.NombreUsuario?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id"/>
                                        <button type="submit"
                                                class="btn btn-sm @(u.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                            @if (u.Activo)
                                            {
                                                <i class="bi bi-person-x"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-person-check"></i>
                                            }
                                        </button>
                                    </form>
                                }
                                else if (u.Id == currentUserId)
                                {
                                    <span class="text-muted small" title="Tu cuenta actual"><i class="bi bi-person-badge"></i></span>
                                }
                                @if (esSuperAdmin && u.Id != currentUserId)
                                {
                                    <form asp-action="EliminarUsuario" method="post" class="d-inline"
                                          onsubmit="return confirm('⚠️ ¿Eliminar PERMANENTEMENTE al usuario @u.NombreUsuario? Esta acción no se puede deshacer.')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id"/>
                                        <button type="submit" class="btn btn-sm btn-danger" title="Eliminar usuario">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2"></i>
                            No hay usuarios registrados. <a asp-action="CrearUsuario">Crear el primero</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal único para ajustar intentos (fuera de la tabla) -->
<div class="modal fade" id="modalAjustarIntentos" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="bi bi-plus-slash-minus me-2"></i>Intentos diarios</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AjustarIntentos" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="intentosUsuarioId" name="id" value=""/>
                <div class="modal-body">
                    <p class="mb-2 fw-semibold" id="intentosNombreUsuario"></p>
                    <label class="form-label small">Intentos extra (base 5)</label>
                    <input type="number" id="intentosExtraInput" name="intentosExtra"
                           min="0" max="100" class="form-control"/>
                    <div class="form-text">Límite diario total = 5 + extras</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-floppy me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Importar Usuarios desde Excel -->
<div class="modal fade" id="modalImportarUsuarios" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-upload me-2"></i>Importar Usuarios desde Excel
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CargarUsuarios" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        Columnas: <strong>Usuario* | Correo* | Contraseña* | Primer Nombre | Primer Apellido | Celular | DNI</strong>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Archivo Excel (.xlsx)</label>
                        <input type="file" name="archivo" class="form-control"
                               accept=".xlsx,.xls" required/>
                    </div>
                    <a asp-action="DescargarPlantillaUsuarios" class="text-decoration-none small">
                        <i class="bi bi-download me-1"></i>Descargar plantilla de ejemplo
                    </a>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-upload me-2"></i>Importar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Paginación -->
@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Usuarios" asp-route-page="@(page - 1)">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-action="Usuarios" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Usuarios" asp-route-page="@(page + 1)">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
<script>
    // Filtro de búsqueda en tabla
    document.getElementById('busqueda').addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('#tablaUsuarios tbody tr').forEach(function (row) {
            row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });

    // Modal ajustar intentos: poblar con datos del botón clickeado
    document.querySelectorAll('.btn-ajustar-intentos').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('intentosUsuarioId').value   = this.dataset.id;
            document.getElementById('intentosNombreUsuario').textContent = this.dataset.nombre;
            document.getElementById('intentosExtraInput').value  = this.dataset.intentos;
            var modal = new bootstrap.Modal(document.getElementById('modalAjustarIntentos'));
            modal.show();
        });
    });
</script>
}
