@model List<SimulacroExamen.ViewModels.NoticiaListaVM>
@{
    ViewData["Title"] = "Noticias";
    int page       = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
    int totalItems = (int)ViewBag.TotalItems;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-megaphone me-2 text-primary"></i>Noticias</h2>
        <p class="text-muted mb-0">@totalItems noticia(s) publicada(s)</p>
    </div>
    <a asp-action="CrearNoticia" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Nueva Noticia
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-newspaper fs-1 d-block mb-2"></i>
            <p>Aún no has publicado ninguna noticia.</p>
            <a asp-action="CrearNoticia" class="btn btn-primary">Crear primera noticia</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var n in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 @(n.Activo ? "" : "opacity-50")">
                    @if (!string.IsNullOrEmpty(n.ImagenRuta))
                    {
                        <img src="@n.ImagenRuta" class="card-img-top object-fit-cover img-fluid" style="height:180px;max-height:180px" alt="@n.Titulo" />
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-start justify-content-between mb-1 gap-2">
                            <h5 class="fw-bold card-title mb-0">@n.Titulo</h5>
                            @if (n.Activo)
                            {
                                <span class="badge bg-success flex-shrink-0">Activa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary flex-shrink-0">Inactiva</span>
                            }
                        </div>
                        <p class="card-text text-muted small flex-grow-1"
                           style="white-space:pre-line;max-height:100px;overflow:hidden">@n.Contenido</p>
                        @if (!string.IsNullOrEmpty(n.EnlaceUrl))
                        {
                            <div class="mt-2">
                                <a href="@n.EnlaceUrl" target="_blank" rel="noopener noreferrer"
                                   class="btn btn-sm btn-outline-primary w-100">
                                    <i class="bi bi-link-45deg me-1"></i>Ver enlace
                                </a>
                            </div>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                            <span><i class="bi bi-calendar me-1"></i>@n.FechaPublicacion.ToString("dd/MM/yyyy")</span>
                            <span><i class="bi bi-person me-1"></i>@n.AdminNombre</span>
                        </div>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-end gap-2 flex-wrap">
                        <a asp-action="EditarNoticia" asp-route-id="@n.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </a>
                        <form asp-action="ToggleNoticia" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.Id"/>
                            <button type="submit" class="btn btn-sm @(n.Activo ? "btn-outline-warning" : "btn-outline-success")">
                                @if (n.Activo)
                                {
                                    <i class="bi bi-eye-slash me-1"></i><text>Desactivar</text>
                                }
                                else
                                {
                                    <i class="bi bi-eye me-1"></i><text>Activar</text>
                                }
                            </button>
                        </form>
                        <form asp-action="EliminarNoticia" method="post"
                              onsubmit="return confirm('¿Eliminar esta noticia?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.Id"/>
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Eliminar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Noticias" asp-route-page="@(page - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" asp-action="Noticias" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Noticias" asp-route-page="@(page + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
