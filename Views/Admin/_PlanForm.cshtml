@model SimulacroExamen.Models.PlanSuscripcion

<!-- Nombre y etiqueta -->
<div class="row g-3 mb-3">
    <div class="col-8">
        <label class="form-label fw-semibold">Nombre del plan <span class="text-danger">*</span></label>
        <input id="previewNombre" name="Nombre" class="form-control preview-trigger"
               value="@Model.Nombre" maxlength="100" required
               placeholder="Ej: El Aplicado"/>
    </div>
    <div class="col-4">
        <label class="form-label fw-semibold">Orden</label>
        <input name="Orden" type="number" class="form-control"
               value="@Model.Orden" min="0" max="999"/>
        <div class="form-text">Menor = primero</div>
    </div>
</div>

<div class="mb-3">
    <label class="form-label fw-semibold">Etiqueta <span class="text-danger">*</span></label>
    <input id="previewEtiqueta" name="Etiqueta" class="form-control preview-trigger"
           value="@Model.Etiqueta" maxlength="100" required
           placeholder="Ej: PLAN MENSUAL"/>
</div>

<!-- Precio -->
<div class="row g-3 mb-3">
    <div class="col-5">
        <label class="form-label fw-semibold">Precio (S/) <span class="text-danger">*</span></label>
        <input id="previewPrecio" name="Precio" type="number" step="0.01" min="0"
               class="form-control preview-trigger"
               value="@Model.Precio" required/>
    </div>
    <div class="col-7">
        <label class="form-label fw-semibold">Texto junto al precio <span class="text-danger">*</span></label>
        <input id="previewTextoPrecio" name="TextoPrecio" class="form-control preview-trigger"
               value="@Model.TextoPrecio" maxlength="50" required
               placeholder="Ej: mensuales"/>
    </div>
</div>

<!-- Colores -->
<div class="row g-3 mb-3">
    <div class="col-6">
        <label class="form-label fw-semibold">Color primario (degradado inicio)</label>
        <div class="input-group">
            <input id="previewColor1" type="color" name="ColorPrimario"
                   class="form-control form-control-color preview-trigger"
                   value="@Model.ColorPrimario" title="Color inicio"/>
            <input type="text" class="form-control font-monospace small color-text"
                   data-target="previewColor1" value="@Model.ColorPrimario"
                   maxlength="7" placeholder="#74c0fc"/>
        </div>
    </div>
    <div class="col-6">
        <label class="form-label fw-semibold">Color secundario (degradado fin)</label>
        <div class="input-group">
            <input id="previewColor2" type="color" name="ColorSecundario"
                   class="form-control form-control-color preview-trigger"
                   value="@Model.ColorSecundario" title="Color fin"/>
            <input type="text" class="form-control font-monospace small color-text"
                   data-target="previewColor2" value="@Model.ColorSecundario"
                   maxlength="7" placeholder="#4dabf7"/>
        </div>
    </div>
</div>

<!-- Características -->
<div class="mb-3">
    <label class="form-label fw-semibold">Características <span class="text-danger">*</span></label>
    <textarea id="previewCaracteristicas" name="CaracteristicasTexto" class="form-control preview-trigger"
              rows="6" required
              placeholder="Una característica por línea. Usa **texto** para negrita.&#10;Ej: Acceso **ilimitado** a simulacros.">@string.Join("\n", Model.Caracteristicas.OrderBy(c => c.Orden).Select(c => c.Texto))</textarea>
    <div class="form-text">
        Una característica por línea. Usa <code>**texto**</code> para resaltar en <strong>negrita</strong>.
    </div>
</div>

<!-- Badge especial -->
<div class="mb-3">
    <label class="form-label fw-semibold">Badge especial <small class="text-muted">(opcional)</small></label>
    <input id="previewBadge" name="TextoBadge" class="form-control preview-trigger"
           value="@Model.TextoBadge" maxlength="200"
           placeholder="Ej: Solo para los 50 Primeros ¡Hasta agotar cupo!"/>
    <div class="form-text">Aparece como aviso de alerta amarillo encima de las características.</div>
</div>

<!-- Enlace y botón -->
<div class="mb-3">
    <label class="form-label fw-semibold">Enlace del botón <span class="text-danger">*</span></label>
    <input name="EnlaceBoton" type="url" class="form-control"
           value="@Model.EnlaceBoton" maxlength="500" required
           placeholder="https://wa.me/51936037152"/>
</div>

<div class="mb-3">
    <label class="form-label fw-semibold">Texto del botón <span class="text-danger">*</span></label>
    <input id="previewTextoBoton" name="TextoBoton" class="form-control preview-trigger"
           value="@Model.TextoBoton" maxlength="80" required
           placeholder="¡Suscribirme ya!"/>
</div>

<!-- Opciones -->
<div class="row g-3 mb-1">
    <div class="col-6">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" name="EsPopular"
                   id="esPopular" value="true" @(Model.EsPopular ? "checked" : "")/>
            <label class="form-check-label" for="esPopular">
                <i class="bi bi-fire text-danger me-1"></i>Marcar como <strong>Más Popular</strong>
            </label>
        </div>
    </div>
    <div class="col-6">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" name="Activo"
                   id="activoPlan" value="true" @(Model.Activo ? "checked" : "")/>
            <label class="form-check-label" for="activoPlan">
                <i class="bi bi-eye text-success me-1"></i><strong>Visible</strong> para usuarios
            </label>
        </div>
    </div>
</div>
