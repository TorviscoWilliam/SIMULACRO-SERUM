@{
    ViewData["Title"] = "Dashboard";
    double promedio = (double)ViewBag.PromedioGlobal;
    var chartLabels = (string[])ViewBag.ChartLabels;
    var chartData   = (int[])ViewBag.ChartData;
    var tipoLabels  = (string[])ViewBag.TipoLabels;
    var tipoCounts  = (int[])ViewBag.TipoCounts;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard</h2>
        <p class="text-muted mb-0">Resumen general del sistema</p>
    </div>
    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
        <i class="bi bi-shield-fill-check me-1"></i>Administrador
    </span>
</div>

<!-- Tarjetas de estadísticas -->
<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-3">
                    <i class="bi bi-people-fill fs-2"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 text-primary">@ViewBag.TotalUsuarios</div>
                    <div class="text-muted small">Usuarios Activos</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success rounded-3 p-3">
                    <i class="bi bi-question-circle-fill fs-2"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 text-success">@ViewBag.TotalPreguntas</div>
                    <div class="text-muted small">Preguntas Activas</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-info-subtle text-info rounded-3 p-3">
                    <i class="bi bi-journal-check fs-2"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 text-info">@ViewBag.TotalExamenes</div>
                    <div class="text-muted small">Exámenes Realizados</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning-subtle text-warning rounded-3 p-3">
                    <i class="bi bi-graph-up-arrow fs-2"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 text-warning">@promedio.ToString("0.0")%</div>
                    <div class="text-muted small">Promedio Global</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos -->
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-bar-chart-line me-2 text-info"></i>Exámenes últimos 7 días
                </h5>
            </div>
            <div class="card-body">
                <canvas id="chartExamenes" height="120"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-pie-chart me-2 text-success"></i>Preguntas por tipo
                </h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                @if (tipoCounts.Any(c => c > 0))
                {
                    <canvas id="chartTipos" height="160"></canvas>
                }
                else
                {
                    <p class="text-muted small text-center">
                        <i class="bi bi-question-circle fs-3 d-block mb-2"></i>
                        Sin preguntas cargadas aún.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Acciones rápidas -->
<div class="row g-4">
    <div class="col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-people me-2 text-primary"></i>Gestión de Usuarios</h5>
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-controller="Admin" asp-action="Usuarios"
                   class="btn btn-outline-primary">
                    <i class="bi bi-list-ul me-2"></i>Ver todos los usuarios
                </a>
                <a asp-controller="Admin" asp-action="CrearUsuario"
                   class="btn btn-primary">
                    <i class="bi bi-person-plus me-2"></i>Crear nuevo usuario
                </a>
                <a asp-controller="Admin" asp-action="ExportarUsuarios"
                   class="btn btn-outline-success">
                    <i class="bi bi-file-earmark-excel me-2"></i>Exportar a Excel
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-question-circle me-2 text-success"></i>Gestión de Preguntas</h5>
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-controller="Admin" asp-action="Preguntas"
                   class="btn btn-outline-success">
                    <i class="bi bi-list-check me-2"></i>Ver todas las preguntas
                </a>
                <a asp-controller="Admin" asp-action="CrearPregunta"
                   class="btn btn-success">
                    <i class="bi bi-plus-circle me-2"></i>Agregar pregunta
                </a>
                <a asp-controller="Admin" asp-action="DescargarPlantilla"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-download me-2"></i>Descargar plantilla Excel
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-mortarboard me-2" style="color:#6f42c1"></i>Tipos de Examen</h5>
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-controller="Admin" asp-action="TiposExamen"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-list-ul me-2"></i>Ver todos los tipos
                </a>
                <a asp-controller="Admin" asp-action="CrearTipo"
                   class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Crear nuevo tipo
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
    // ── Gráfico de línea: exámenes últimos 7 días ──
    new Chart(document.getElementById('chartExamenes'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartLabels)),
            datasets: [{
                label: 'Exámenes',
                data:  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartData)),
                backgroundColor: 'rgba(13,110,253,0.15)',
                borderColor:     'rgba(13,110,253,0.8)',
                borderWidth: 2,
                borderRadius: 6,
                fill: true
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1 } }
            }
        }
    });

    // ── Gráfico de dona: preguntas por tipo ──
    @if (tipoCounts.Any(c => c > 0))
    {
        <text>
    const colors = [
        '#0d6efd','#198754','#0dcaf0','#ffc107','#dc3545',
        '#6f42c1','#fd7e14','#20c997','#6c757d','#d63384'
    ];
    new Chart(document.getElementById('chartTipos'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tipoLabels)),
            datasets: [{
                data:            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tipoCounts)),
                backgroundColor: colors.slice(0, @tipoCounts.Length),
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
            }
        }
    });
        </text>
    }
</script>
}
