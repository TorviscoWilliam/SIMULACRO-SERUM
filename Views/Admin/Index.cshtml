@using SimulacroExamen.ViewModels
@{
    ViewData["Title"] = "Dashboard";
    double promedio          = (double)ViewBag.PromedioGlobal;
    var    chartLabels       = (string[])ViewBag.ChartLabels;
    var    chartData         = (int[])ViewBag.ChartData;
    var    tipoLabels        = (string[])ViewBag.TipoLabels;
    var    tipoCounts        = (int[])ViewBag.TipoCounts;
    int    examenesHoy       = (int)ViewBag.ExamenesHoy;
    int    usuariosHoy       = (int)ViewBag.UsuariosActivosHoy;
    double tasaAprobacion    = (double)ViewBag.TasaAprobacionHoy;
    double mejorHoy          = (double)ViewBag.MejorPuntajeHoyVigesimal;
    var    rankingGeneral    = (List<TopRankingVM>)ViewBag.RankingGeneral;
    var    rankingPorTipo    = (Dictionary<string, List<TopRankingVM>>)ViewBag.RankingPorTipo;
    var    hoyStr            = DateTime.Today.ToString("dd/MM/yyyy");
    string filtroFechaInput  = (string)ViewBag.FiltroFecha;
    string filtroUsuario     = (string)ViewBag.FiltroUsuario;
    string filtroFechaStr    = (string)ViewBag.FiltroFechaStr;
    bool   esFiltrado        = (bool)ViewBag.EsFiltrado;
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard</h2>
        <p class="text-muted mb-0">Resumen general del sistema · @hoyStr</p>
    </div>
    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
        <i class="bi bi-shield-fill-check me-1"></i>Administrador
    </span>
</div>

<!-- ── FILA 1: Stats generales ──────────────────────────────────── -->
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-primary-subtle text-primary">
                    <i class="bi bi-mortarboard-fill fs-3"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 text-primary lh-1">@ViewBag.TotalUsuarios</div>
                    <div class="text-muted small mt-1">Estudiantes activos</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-success-subtle text-success">
                    <i class="bi bi-question-circle-fill fs-3"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 text-success lh-1">@ViewBag.TotalPreguntas</div>
                    <div class="text-muted small mt-1">Preguntas activas</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-info-subtle text-info">
                    <i class="bi bi-journal-check fs-3"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 text-info lh-1">@ViewBag.TotalExamenes</div>
                    <div class="text-muted small mt-1">Exámenes totales</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-warning-subtle text-warning">
                    <i class="bi bi-graph-up-arrow fs-3"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 text-warning lh-1">@promedio.ToString("0.0")%</div>
                    <div class="text-muted small mt-1">Promedio global</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── FILA 2: Stats de hoy ─────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 border-top border-4 border-primary">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-primary-subtle text-primary">
                    <i class="bi bi-calendar-check fs-3"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 text-primary lh-1">@examenesHoy</div>
                    <div class="text-muted small mt-1">Exámenes · @filtroFechaStr</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 border-top border-4 border-success">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-success-subtle text-success">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 text-success lh-1">@usuariosHoy</div>
                    <div class="text-muted small mt-1">Usuarios · @filtroFechaStr</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 border-top border-4 @(tasaAprobacion >= 60 ? "border-success" : tasaAprobacion >= 40 ? "border-warning" : "border-danger")">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 @(tasaAprobacion >= 60 ? "bg-success-subtle text-success" : tasaAprobacion >= 40 ? "bg-warning-subtle text-warning" : "bg-danger-subtle text-danger")">
                    <i class="bi bi-patch-check-fill fs-3"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 lh-1 @(tasaAprobacion >= 60 ? "text-success" : tasaAprobacion >= 40 ? "text-warning" : "text-danger")">
                        @tasaAprobacion.ToString("0.0")%
                    </div>
                    <div class="text-muted small mt-1">Aprobación · @filtroFechaStr</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 border-top border-4 border-warning">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-warning-subtle text-warning">
                    <i class="bi bi-trophy-fill fs-3"></i>
                </div>
                <div>
                    <div class="fw-bold fs-2 text-warning lh-1">@mejorHoy.ToString("0.##")</div>
                    <div class="text-muted small mt-1">Mejor puntaje · @filtroFechaStr</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Gráficos ─────────────────────────────────────────────────── -->
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-bar-chart-line me-2 text-info"></i>Exámenes últimos 7 días
                </h6>
                <span class="badge bg-info-subtle text-info border border-info-subtle">
                    Total: @chartData.Sum()
                </span>
            </div>
            <div class="card-body pt-0">
                <canvas id="chartExamenes" height="120"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-pie-chart me-2 text-success"></i>Preguntas por tipo
                </h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center pt-0">
                @if (tipoCounts.Any(c => c > 0))
                {
                    <canvas id="chartTipos" height="170"></canvas>
                }
                else
                {
                    <p class="text-muted small text-center py-4">
                        <i class="bi bi-question-circle fs-3 d-block mb-2"></i>
                        Sin preguntas cargadas aún.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<!-- ── TOP 10 DIARIO ────────────────────────────────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-trophy me-2 text-warning"></i>Top 10
                    @if (esFiltrado)
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1 fw-normal fs-6">Filtrado</span>
                    }
                    else
                    {
                        <span class="text-muted fw-normal fs-6">del Día</span>
                    }
                </h5>
                <p class="text-muted small mb-0">
                    Mejores puntajes ·
                    @if (!string.IsNullOrEmpty(filtroUsuario))
                    {
                        <span>usuario: <strong>@filtroUsuario</strong> ·</span>
                    }
                    @filtroFechaStr
                </p>
            </div>
            @if (esFiltrado)
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Limpiar filtro
                </a>
            }
        </div>

        <!-- Formulario de filtro -->
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label class="form-label small fw-semibold mb-1">
                    <i class="bi bi-calendar3 me-1"></i>Fecha
                </label>
                <input type="date" name="fecha" class="form-control form-control-sm"
                       value="@filtroFechaInput"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")"/>
            </div>
            <div class="col-sm-5 col-md-4">
                <label class="form-label small fw-semibold mb-1">
                    <i class="bi bi-person-search me-1"></i>Usuario
                </label>
                <input type="text" name="usuario" class="form-control form-control-sm"
                       value="@filtroUsuario"
                       placeholder="Buscar por nombre de usuario..."/>
            </div>
            <div class="col-sm-3 col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-search me-1"></i>Buscar
                </button>
            </div>
        </form>
    </div>

    @if (!rankingGeneral.Any())
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-search text-muted d-block mb-3" style="font-size:3rem"></i>
            <h6 class="text-muted">Sin resultados para @filtroFechaStr</h6>
            <p class="text-muted small mb-0">
                @if (!string.IsNullOrEmpty(filtroUsuario))
                {
                    <span>No se encontraron exámenes del usuario "<strong>@filtroUsuario</strong>" en esa fecha.</span>
                }
                else
                {
                    <span>No hay exámenes completados en esa fecha.</span>
                }
            </p>
        </div>
    }
    else
    {
        <div class="card-body p-0">
            <!-- Tabs por tipo de examen -->
            <ul class="nav nav-tabs px-3 pt-3 border-0" id="rankingTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-semibold" id="tab-general" data-bs-toggle="tab"
                            data-bs-target="#panel-general" type="button" role="tab">
                        <i class="bi bi-list-stars me-1"></i>General
                        <span class="badge bg-primary ms-1">@rankingGeneral.Count</span>
                    </button>
                </li>
                @foreach (var tipo in rankingPorTipo.Keys)
                {
                    var tabId   = "tab-"   + tipo.Replace(" ", "-").Replace(".", "").Replace("/", "");
                    var panelId = "panel-" + tipo.Replace(" ", "-").Replace(".", "").Replace("/", "");
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold small" id="@tabId" data-bs-toggle="tab"
                                data-bs-target="#@panelId" type="button" role="tab">
                            @tipo
                            <span class="badge bg-secondary ms-1">@rankingPorTipo[tipo].Count</span>
                        </button>
                    </li>
                }
            </ul>

            <div class="tab-content" id="rankingTabsContent">

                <!-- Pestaña: General -->
                <div class="tab-pane fade show active" id="panel-general" role="tabpanel">
                    @await Html.PartialAsync("_RankingTable", rankingGeneral)
                </div>

                <!-- Pestañas: por tipo -->
                @foreach (var tipo in rankingPorTipo.Keys)
                {
                    var panelId = "panel-" + tipo.Replace(" ", "-").Replace(".", "").Replace("/", "");
                    <div class="tab-pane fade" id="@panelId" role="tabpanel">
                        @await Html.PartialAsync("_RankingTable", rankingPorTipo[tipo])
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- ── Acciones rápidas ─────────────────────────────────────────── -->
<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-people me-2 text-primary"></i>Gestión de Usuarios</h6>
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-action="Usuarios"    class="btn btn-outline-primary btn-sm"><i class="bi bi-list-ul me-2"></i>Ver todos los usuarios</a>
                <a asp-action="CrearUsuario" class="btn btn-primary btn-sm"><i class="bi bi-person-plus me-2"></i>Crear nuevo usuario</a>
                <a asp-action="ExportarUsuarios" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel me-2"></i>Exportar a Excel</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-question-circle me-2 text-success"></i>Gestión de Preguntas</h6>
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-action="Preguntas"         class="btn btn-outline-success btn-sm"><i class="bi bi-list-check me-2"></i>Ver todas las preguntas</a>
                <a asp-action="CrearPregunta"     class="btn btn-success btn-sm"><i class="bi bi-plus-circle me-2"></i>Agregar pregunta</a>
                <a asp-action="DescargarPlantilla" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download me-2"></i>Descargar plantilla Excel</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-mortarboard me-2" style="color:#6f42c1"></i>Tipos de Examen</h6>
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-action="TiposExamen" class="btn btn-outline-secondary btn-sm"><i class="bi bi-list-ul me-2"></i>Ver todos los tipos</a>
                <a asp-action="CrearTipo"   class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-2"></i>Crear nuevo tipo</a>
                <div class="mt-1 p-2 bg-light rounded small text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>@ViewBag.TotalAdmins</strong> administrador(es) ·
                    <strong>@ViewBag.TotalUsuarios</strong> estudiante(s)
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
    // ── Gráfico barras: exámenes últimos 7 días ──
    new Chart(document.getElementById('chartExamenes'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartLabels)),
            datasets: [{
                label: 'Exámenes',
                data:  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartData)),
                backgroundColor: 'rgba(13,110,253,0.15)',
                borderColor:     'rgba(13,110,253,0.8)',
                borderWidth: 2,
                borderRadius: 6,
                fill: true
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    // ── Gráfico dona: preguntas por tipo ──
    @if (tipoCounts.Any(c => c > 0))
    {
        <text>
    const colors = [
        '#0d6efd','#198754','#0dcaf0','#ffc107','#dc3545',
        '#6f42c1','#fd7e14','#20c997','#6c757d','#d63384',
        '#0d6efd','#198754','#0dcaf0','#ffc107','#dc3545',
        '#6f42c1','#fd7e14','#20c997'
    ];
    new Chart(document.getElementById('chartTipos'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tipoLabels)),
            datasets: [{
                data:            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tipoCounts)),
                backgroundColor: colors.slice(0, @tipoCounts.Length),
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
            }
        }
    });
        </text>
    }
</script>
}
