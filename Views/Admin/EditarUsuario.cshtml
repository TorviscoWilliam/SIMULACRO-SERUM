@model EditarUsuarioViewModel
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-4">
                <h4 class="fw-bold mb-0">
                    <i class="bi bi-pencil-square me-2 text-warning"></i>Editar Usuario
                </h4>
                <p class="text-muted small mb-0 mt-1">
                    Modifica los datos del usuario. Deja la contraseña en blanco para no cambiarla.
                </p>
            </div>

            <div class="card-body p-4">
                <form asp-action="EditarUsuario" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger py-2 small"></div>

                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="NombreUsuario" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="NombreUsuario" class="form-control" />
                        </div>
                        <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Correo" class="form-control" />
                        </div>
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Rol" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield"></i></span>
                            <select asp-for="Rol" class="form-select">
                                <option value="Usuario">Estudiante</option>
                                <option value="Admin">Administrador</option>
                            </select>
                        </div>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>

                    <hr class="my-3" />
                    <p class="fw-semibold text-muted small mb-2 text-uppercase">
                        <i class="bi bi-person-vcard me-1"></i>Datos Personales (opcionales)
                    </p>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label asp-for="PrimerNombre" class="form-label fw-semibold small"></label>
                            <input asp-for="PrimerNombre" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label asp-for="SegundoNombre" class="form-label fw-semibold small"></label>
                            <input asp-for="SegundoNombre" class="form-control form-control-sm" placeholder="Opcional" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="PrimerApellido" class="form-label fw-semibold small"></label>
                            <input asp-for="PrimerApellido" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label asp-for="SegundoApellido" class="form-label fw-semibold small"></label>
                            <input asp-for="SegundoApellido" class="form-control form-control-sm" placeholder="Opcional" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="Celular" class="form-label fw-semibold small"></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-phone"></i></span>
                                <input asp-for="Celular" class="form-control" placeholder="Opcional" />
                            </div>
                            <span asp-validation-for="Celular" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Dni" class="form-label fw-semibold small"></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                                <input asp-for="Dni" class="form-control" placeholder="8 dígitos"
                                       maxlength="8" inputmode="numeric" />
                            </div>
                            <span asp-validation-for="Dni" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-3" />
                    <p class="text-muted small mb-3"><i class="bi bi-info-circle me-1"></i>Cambio de contraseña opcional — dejar vacío para conservar la actual.</p>

                    <div class="mb-3">
                        <label asp-for="ContrasenaNueva" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="ContrasenaNueva" class="form-control"
                                   placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePass1">
                                <i class="bi bi-eye" id="eye1"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ContrasenaNueva" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmarContrasena" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="ConfirmarContrasena" class="form-control"
                                   placeholder="Repita la nueva contraseña" autocomplete="new-password" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePass2">
                                <i class="bi bi-eye" id="eye2"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning flex-fill">
                            <i class="bi bi-floppy me-2"></i>Guardar Cambios
                        </button>
                        <a asp-action="Usuarios" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    function togglePwd(btnId, eyeId, inputId) {
        document.getElementById(btnId).addEventListener('click', function () {
            const inp  = document.querySelector('[name="' + inputId + '"]');
            const icon = document.getElementById(eyeId);
            inp.type   = inp.type === 'password' ? 'text' : 'password';
            icon.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        });
    }
    togglePwd('togglePass1', 'eye1', 'ContrasenaNueva');
    togglePwd('togglePass2', 'eye2', 'ConfirmarContrasena');
</script>
}
