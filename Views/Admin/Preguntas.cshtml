@model List<Pregunta>
@{
    ViewData["Title"] = "Preguntas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-question-circle me-2 text-success"></i>Banco de Preguntas</h2>
        <p class="text-muted mb-0">@Model.Count pregunta(s) activa(s)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="DescargarPlantilla" class="btn btn-outline-secondary">
            <i class="bi bi-download me-2"></i>Plantilla Excel
        </a>
        <button class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalImportar">
            <i class="bi bi-upload me-2"></i>Importar Excel
        </button>
        <a asp-action="CrearPregunta" class="btn btn-success">
            <i class="bi bi-plus-circle me-2"></i>Nueva Pregunta
        </a>
    </div>
</div>

<!-- Búsqueda -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <input type="text" id="busqueda" class="form-control"
               placeholder="Buscar pregunta...">
    </div>
</div>

<!-- Lista de preguntas -->
<div class="accordion" id="accordionPreguntas">
    @for (int i = 0; i < Model.Count; i++)
    {
        var p = Model[i];
        var correcta = p.Alternativas.FirstOrDefault(a => a.EsCorrecta);
        <div class="accordion-item border-0 shadow-sm mb-2 pregunta-item" data-texto="@p.TextoPregunta.ToLower()">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed rounded" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#preg_@p.Id">
                    <div class="d-flex align-items-center gap-3 w-100">
                        <span class="badge bg-success rounded-pill px-3">@(i + 1)</span>
                        <span class="flex-grow-1 text-truncate" style="max-width:70%">
                            @p.TextoPregunta
                        </span>
                        <span class="badge bg-light text-dark border ms-auto me-3 small">
                            @p.Alternativas.Count alternativas
                        </span>
                        <span class="text-muted small me-2">
                            @p.FechaCreacion.ToString("dd/MM/yy")
                        </span>
                    </div>
                </button>
            </h2>
            <div id="preg_@p.Id" class="accordion-collapse collapse">
                <div class="accordion-body">
                    <p class="fw-semibold mb-3">@p.TextoPregunta</p>

                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var alt in p.Alternativas)
                        {
                            <li class="list-group-item d-flex align-items-center gap-2
                                       @(alt.EsCorrecta ? "list-group-item-success" : "")">
                                @if (alt.EsCorrecta)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle text-muted"></i>
                                }
                                @alt.TextoAlternativa
                                @if (alt.EsCorrecta)
                                {
                                    <span class="badge bg-success ms-auto">Correcta</span>
                                }
                            </li>
                        }
                    </ul>

                    <div class="d-flex justify-content-end">
                        <form asp-action="EliminarPregunta" method="post"
                              onsubmit="return confirm('¿Eliminar esta pregunta?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id"/>
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Eliminar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-question-circle fs-1 d-block mb-2"></i>
            No hay preguntas registradas.
            <a asp-action="CrearPregunta">Agregar la primera</a> o
            <a asp-action="DescargarPlantilla">descargar plantilla</a> para importar.
        </div>
    }
</div>

<!-- Modal Importar Excel -->
<div class="modal fade" id="modalImportar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-upload me-2"></i>Importar Preguntas desde Excel
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CargarPreguntas" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        Use el formato de la plantilla. Columnas:
                        <strong>Pregunta | Resp. Correcta | Opción 2 | Opción 3 | Opción 4</strong>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Archivo Excel (.xlsx)</label>
                        <input type="file" name="archivo" class="form-control"
                               accept=".xlsx,.xls" required/>
                    </div>
                    <a asp-action="DescargarPlantilla" class="text-decoration-none small">
                        <i class="bi bi-download me-1"></i>Descargar plantilla de ejemplo
                    </a>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-upload me-2"></i>Importar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('busqueda').addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('.pregunta-item').forEach(function (item) {
            item.style.display = item.dataset.texto.includes(q) ? '' : 'none';
        });
    });
</script>
}
