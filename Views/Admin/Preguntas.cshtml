@model List<Pregunta>
@{
    ViewData["Title"] = "Preguntas";
    var tipos      = (List<SimulacroExamen.Models.TipoExamen>)ViewBag.Tipos;
    var tipoId     = (int?)ViewBag.TipoId;
    int page       = (int)ViewBag.Page;
    int pageSize   = (int)ViewBag.PageSize;
    int totalPages = (int)ViewBag.TotalPages;
    int totalItems = (int)ViewBag.TotalItems;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-question-circle me-2 text-success"></i>Banco de Preguntas</h2>
        <p class="text-muted mb-0">@totalItems pregunta(s) activa(s)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportarPreguntas" asp-route-tipoId="@tipoId" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-2"></i>Exportar Excel
        </a>
        <a asp-action="DescargarPlantilla" class="btn btn-outline-secondary">
            <i class="bi bi-download me-2"></i>Plantilla Excel
        </a>
        <button class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalImportar">
            <i class="bi bi-upload me-2"></i>Importar Excel
        </button>
        <a asp-action="CrearPregunta" class="btn btn-success">
            <i class="bi bi-plus-circle me-2"></i>Nueva Pregunta
        </a>
    </div>
</div>

<!-- Filtro por tipo -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <form method="get" asp-action="Preguntas" class="d-flex gap-2">
                    <select name="tipoId" class="form-select">
                        <option value="">— Todos los tipos —</option>
                        @foreach (var t in tipos)
                        {
                            @if (tipoId == t.Id)
                            {
                                <option value="@t.Id" selected="selected">@t.Nombre</option>
                            }
                            else
                            {
                                <option value="@t.Id">@t.Nombre</option>
                            }
                        }
                    </select>
                    <input type="hidden" name="pageSize" value="@pageSize" />
                    <button type="submit" class="btn btn-outline-primary text-nowrap">
                        <i class="bi bi-funnel me-1"></i>Filtrar
                    </button>
                    @if (tipoId.HasValue)
                    {
                        <a asp-action="Preguntas" asp-route-pageSize="@pageSize" class="btn btn-outline-secondary text-nowrap">
                            <i class="bi bi-x me-1"></i>Limpiar
                        </a>
                    }
                </form>
            </div>
            <div class="col-md-4">
                <input type="text" id="busqueda" class="form-control"
                       placeholder="Buscar pregunta...">
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small text-nowrap mb-0">Mostrar:</label>
                    <div class="btn-group btn-group-sm" role="group">
                        @foreach (var size in new[] { 10, 25, 100 })
                        {
                            <a href="@Url.Action("Preguntas", "Admin", new { tipoId = tipoId, page = 1, pageSize = size })"
                               class="btn @(pageSize == size ? "btn-success" : "btn-outline-secondary")">@size</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Barra de selección masiva (se muestra al seleccionar al menos 1) -->
<div id="barraAcciones" class="card border-0 shadow-sm mb-3 d-none">
    <div class="card-body py-2 d-flex align-items-center gap-3 flex-wrap">
        <span class="fw-semibold text-primary">
            <i class="bi bi-check2-square me-1"></i>
            <span id="contadorSeleccion">0</span> seleccionada(s)
        </span>
        <div class="d-flex gap-2 ms-auto flex-wrap">
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmarEliminarMasa()">
                <i class="bi bi-trash me-1"></i>Eliminar selección
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalAsignarTipo">
                <i class="bi bi-arrow-left-right me-1"></i>Asignar a otro examen
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="deseleccionarTodo()">
                <i class="bi bi-x me-1"></i>Deseleccionar
            </button>
        </div>
    </div>
</div>

<!-- Formulario oculto para acciones masivas -->
<form id="formMasa" method="post" style="display:none">
    @Html.AntiForgeryToken()
    <div id="hiddenIds"></div>
    <input type="hidden" name="nuevoTipoId" id="hiddenNuevoTipoId" value="0"/>
</form>

<!-- Checkbox "seleccionar todos" -->
@if (Model.Any())
{
    <div class="d-flex align-items-center gap-2 mb-2 px-1">
        <input type="checkbox" id="selectAll" class="form-check-input mt-0" style="cursor:pointer">
        <label for="selectAll" class="text-muted small" style="cursor:pointer">Seleccionar todos en esta página</label>
    </div>
}

<!-- Lista de preguntas -->
<div class="accordion" id="accordionPreguntas">
    @for (int i = 0; i < Model.Count; i++)
    {
        var p = Model[i];
        <div class="accordion-item border-0 shadow-sm mb-2 pregunta-item" data-texto="@p.TextoPregunta.ToLower()" data-id="@p.Id">
            <h2 class="accordion-header">
                <div class="d-flex align-items-stretch">
                    <!-- Checkbox de selección -->
                    <div class="ps-3 pe-2 d-flex align-items-center flex-shrink-0" style="min-width:44px">
                        <input type="checkbox" class="form-check-input pregunta-check mt-0"
                               data-id="@p.Id" style="cursor:pointer"
                               onclick="event.stopPropagation()">
                    </div>
                    <button class="accordion-button collapsed flex-grow-1 py-3" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#preg_@p.Id"
                            style="min-width:0">
                        <div class="d-flex align-items-center gap-2 w-100" style="min-width:0; padding-right:0.5rem">
                            <span class="badge bg-success rounded-pill flex-shrink-0" style="min-width:2rem">@((page - 1) * pageSize + i + 1)</span>
                            @if (p.TipoExamen != null)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle small text-nowrap flex-shrink-0">
                                    @p.TipoExamen.Nombre
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border small text-nowrap flex-shrink-0">Sin tipo</span>
                            }
                            <span class="flex-grow-1 text-truncate small" style="min-width:0">
                                @p.TextoPregunta
                            </span>
                            <span class="badge bg-light text-dark border small flex-shrink-0 ms-2">
                                @p.Alternativas.Count alternativas
                            </span>
                            <span class="text-muted small flex-shrink-0 ms-2">
                                @p.FechaCreacion.ToString("dd/MM/yy")
                            </span>
                        </div>
                    </button>
                </div>
            </h2>
            <div id="preg_@p.Id" class="accordion-collapse collapse">
                <div class="accordion-body">
                    <p class="fw-semibold mb-3">@p.TextoPregunta</p>

                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var alt in p.Alternativas)
                        {
                            <li class="list-group-item d-flex align-items-center gap-2
                                       @(alt.EsCorrecta ? "list-group-item-success" : "")">
                                @if (alt.EsCorrecta)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle text-muted"></i>
                                }
                                @alt.TextoAlternativa
                                @if (alt.EsCorrecta)
                                {
                                    <span class="badge bg-success ms-auto">Correcta</span>
                                }
                            </li>
                        }
                    </ul>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="EditarPregunta" asp-route-id="@p.Id"
                           class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </a>
                        <form asp-action="EliminarPregunta" method="post"
                              onsubmit="return confirm('¿Eliminar esta pregunta?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id"/>
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Eliminar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-question-circle fs-1 d-block mb-2"></i>
            No hay preguntas registradas.
            <a asp-action="CrearPregunta">Agregar la primera</a> o
            <a asp-action="DescargarPlantilla">descargar plantilla</a> para importar.
        </div>
    }
</div>

<!-- Paginación -->
@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Preguntas"
                   asp-route-page="@(page - 1)" asp-route-tipoId="@tipoId" asp-route-pageSize="@pageSize">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-action="Preguntas"
                       asp-route-page="@i" asp-route-tipoId="@tipoId" asp-route-pageSize="@pageSize">@i</a>
                </li>
            }
            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Preguntas"
                   asp-route-page="@(page + 1)" asp-route-tipoId="@tipoId" asp-route-pageSize="@pageSize">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

<!-- Modal Importar Excel -->
<div class="modal fade" id="modalImportar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-upload me-2"></i>Importar Preguntas desde Excel
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CargarPreguntas" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de Examen <span class="text-danger">*</span></label>
                        <select name="tipoExamenId" class="form-select" required>
                            <option value="">— Seleccione el tipo —</option>
                            @foreach (var t in tipos)
                            {
                                <option value="@t.Id">@t.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        Columnas: <strong>Pregunta | Resp. Correcta | Opción 2 | Opción 3 | Opción 4</strong>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Archivo Excel (.xlsx)</label>
                        <input type="file" name="archivo" class="form-control"
                               accept=".xlsx,.xls" required/>
                    </div>
                    <a asp-action="DescargarPlantilla" class="text-decoration-none small">
                        <i class="bi bi-download me-1"></i>Descargar plantilla de ejemplo
                    </a>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-upload me-2"></i>Importar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Asignar Tipo de Examen en Masa -->
<div class="modal fade" id="modalAsignarTipo" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-arrow-left-right me-2"></i>Asignar a otro Examen
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Las preguntas seleccionadas serán reasignadas al tipo de examen elegido.</p>
                <label class="form-label fw-semibold">Tipo de Examen destino</label>
                <select id="selectNuevoTipo" class="form-select">
                    <option value="0">— Sin tipo (desvincular) —</option>
                    @foreach (var t in tipos)
                    {
                        <option value="@t.Id">@t.Nombre</option>
                    }
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="confirmarAsignarTipo()">
                    <i class="bi bi-check2 me-1"></i>Reasignar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Búsqueda local ────────────────────────────────────────────
    document.getElementById('busqueda').addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('.pregunta-item').forEach(function (item) {
            item.style.display = item.dataset.texto.includes(q) ? '' : 'none';
        });
    });

    // ── Selección masiva ──────────────────────────────────────────
    function actualizarBarra() {
        const checks  = document.querySelectorAll('.pregunta-check:checked');
        const barra   = document.getElementById('barraAcciones');
        const contador = document.getElementById('contadorSeleccion');
        contador.textContent = checks.length;
        barra.classList.toggle('d-none', checks.length === 0);
    }

    document.querySelectorAll('.pregunta-check').forEach(function (chk) {
        chk.addEventListener('change', actualizarBarra);
    });

    document.getElementById('selectAll')?.addEventListener('change', function () {
        const visible = document.querySelectorAll('.pregunta-item:not([style*="display: none"]) .pregunta-check');
        visible.forEach(c => c.checked = this.checked);
        actualizarBarra();
    });

    function deseleccionarTodo() {
        document.querySelectorAll('.pregunta-check').forEach(c => c.checked = false);
        const sa = document.getElementById('selectAll');
        if (sa) sa.checked = false;
        actualizarBarra();
    }

    function idsSeleccionados() {
        return Array.from(document.querySelectorAll('.pregunta-check:checked'))
                    .map(c => c.dataset.id);
    }

    function rellenarFormMasa(action, ids) {
        const form = document.getElementById('formMasa');
        form.action = action;
        const cont = document.getElementById('hiddenIds');
        cont.innerHTML = '';
        ids.forEach(function (id) {
            const inp = document.createElement('input');
            inp.type  = 'hidden';
            inp.name  = 'ids';
            inp.value = id;
            cont.appendChild(inp);
        });
    }

    function confirmarEliminarMasa() {
        const ids = idsSeleccionados();
        if (ids.length === 0) return;
        if (!confirm('¿Eliminar ' + ids.length + ' pregunta(s) seleccionada(s)? Esta acción no se puede deshacer.')) return;
        rellenarFormMasa('@Url.Action("EliminarPreguntasEnMasa", "Admin")', ids);
        document.getElementById('formMasa').submit();
    }

    function confirmarAsignarTipo() {
        const ids  = idsSeleccionados();
        const tipo = document.getElementById('selectNuevoTipo').value;
        if (ids.length === 0) return;
        rellenarFormMasa('@Url.Action("AsignarTipoEnMasa", "Admin")', ids);
        document.getElementById('hiddenNuevoTipoId').value = tipo;
        document.getElementById('formMasa').submit();
    }
</script>
}
