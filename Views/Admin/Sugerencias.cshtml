@model List<SimulacroExamen.Models.Sugerencia>
@{
    ViewData["Title"] = "Sugerencias";
    int page        = (int)ViewBag.Page;
    int totalPages  = (int)ViewBag.TotalPages;
    int totalItems  = (int)ViewBag.TotalItems;
    int totalNuevas = (int)ViewBag.TotalNuevas;
    string filtro   = (string)ViewBag.Filtro;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-0">
            <i class="bi bi-chat-heart-fill me-2 text-primary"></i>Sugerencias
        </h2>
        <p class="text-muted mb-0">
            @totalItems sugerencia(s) ·
            @if (totalNuevas > 0)
            {
                <span class="text-warning fw-semibold">@totalNuevas nueva(s) sin leer</span>
            }
            else
            {
                <span class="text-success">todas leídas</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (totalNuevas > 0)
        {
            <form asp-action="MarcarTodasLeidas" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-check2-all me-1"></i>Marcar todas como leídas
                </button>
            </form>
        }
    </div>
</div>

<!-- Filtros -->
<div class="d-flex gap-2 mb-4 flex-wrap">
    <a asp-action="Sugerencias" asp-route-filtro="todas"
       class="btn btn-sm @(filtro == "todas" ? "btn-primary" : "btn-outline-secondary")">
        <i class="bi bi-list-ul me-1"></i>Todas
    </a>
    <a asp-action="Sugerencias" asp-route-filtro="nuevas"
       class="btn btn-sm @(filtro == "nuevas" ? "btn-warning" : "btn-outline-warning")">
        <i class="bi bi-envelope-fill me-1"></i>No leídas
        @if (totalNuevas > 0)
        {
            <span class="badge bg-danger ms-1">@totalNuevas</span>
        }
    </a>
    <a asp-action="Sugerencias" asp-route-filtro="leidas"
       class="btn btn-sm @(filtro == "leidas" ? "btn-success" : "btn-outline-success")">
        <i class="bi bi-envelope-open me-1"></i>Leídas
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
            <p class="mb-0">No hay sugerencias en esta categoría.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="list-group list-group-flush">
            @foreach (var s in Model)
            {
                <div class="list-group-item px-4 py-3 @(s.Leida ? "" : "bg-warning-subtle border-start border-warning border-3")">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <!-- Contenido -->
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                @if (!s.Leida)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Nueva
                                    </span>
                                }
                                <strong>@s.Asunto</strong>
                            </div>
                            <p class="mb-2 text-dark" style="white-space:pre-wrap">@s.Mensaje</p>
                            <div class="d-flex gap-3 flex-wrap" style="font-size:.8rem">
                                <span class="text-muted">
                                    <i class="bi bi-person me-1"></i>
                                    @(s.Usuario?.NombreUsuario ?? "–")
                                    @if (!string.IsNullOrEmpty(s.Usuario?.NombreCompleto))
                                    {
                                        <span class="text-muted">(</span>@s.Usuario.NombreCompleto<span class="text-muted">)</span>
                                    }
                                </span>
                                <span class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@s.FechaEnvio.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>
                        </div>
                        <!-- Acciones -->
                        <div class="d-flex flex-column gap-2 flex-shrink-0 align-items-end">
                            <form asp-action="MarcarSugerenciaLeida" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id"/>
                                <button type="submit"
                                        class="btn btn-sm @(s.Leida ? "btn-outline-warning" : "btn-outline-success")"
                                        title="@(s.Leida ? "Marcar como no leída" : "Marcar como leída")">
                                    @if (s.Leida)
                                    {
                                        <i class="bi bi-envelope-fill me-1"></i><text>No leída</text>
                                    }
                                    else
                                    {
                                        <i class="bi bi-envelope-open me-1"></i><text>Leída</text>
                                    }
                                </button>
                            </form>
                            <form asp-action="EliminarSugerencia" method="post"
                                  onsubmit="return confirm('¿Eliminar esta sugerencia?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id"/>
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i>Eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Sugerencias"
                       asp-route-page="@(page - 1)" asp-route-filtro="@filtro">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" asp-action="Sugerencias"
                           asp-route-page="@i" asp-route-filtro="@filtro">@i</a>
                    </li>
                }
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Sugerencias"
                       asp-route-page="@(page + 1)" asp-route-filtro="@filtro">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
