@model CrearUsuarioViewModel
@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-4">
                <h4 class="fw-bold mb-0">
                    <i class="bi bi-person-plus me-2 text-primary"></i>Crear Nuevo Usuario
                </h4>
                <p class="text-muted small mb-0 mt-1">
                    Complete todos los campos para registrar un nuevo usuario.
                </p>
            </div>

            <div class="card-body p-4">
                <form asp-action="CrearUsuario" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger py-2 small"></div>

                    <p class="fw-semibold text-muted small text-uppercase mb-2">Datos personales</p>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="PrimerNombre" class="form-label fw-semibold"></label>
                            <input asp-for="PrimerNombre" class="form-control" placeholder="Primer nombre" />
                            <span asp-validation-for="PrimerNombre" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="SegundoNombre" class="form-label fw-semibold"></label>
                            <input asp-for="SegundoNombre" class="form-control" placeholder="Segundo nombre" />
                            <span asp-validation-for="SegundoNombre" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="PrimerApellido" class="form-label fw-semibold"></label>
                            <input asp-for="PrimerApellido" class="form-control" placeholder="Primer apellido" />
                            <span asp-validation-for="PrimerApellido" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="SegundoApellido" class="form-label fw-semibold"></label>
                            <input asp-for="SegundoApellido" class="form-control" placeholder="Segundo apellido" />
                            <span asp-validation-for="SegundoApellido" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Celular" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-phone"></i></span>
                                <input asp-for="Celular" class="form-control" placeholder="Número de celular" />
                            </div>
                            <span asp-validation-for="Celular" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Dni" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                                <input asp-for="Dni" class="form-control" placeholder="DNI" />
                            </div>
                            <span asp-validation-for="Dni" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-3"/>
                    <p class="fw-semibold text-muted small text-uppercase mb-2">Credenciales</p>

                    <div class="mb-3">
                        <label asp-for="NombreUsuario" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="NombreUsuario" class="form-control"
                                   placeholder="nombre.usuario"/>
                        </div>
                        <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Correo" class="form-control"
                                   placeholder="usuario@correo.com"/>
                        </div>
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Contrasena" class="form-control"
                                   placeholder="Mínimo 6 caracteres"/>
                            <button class="btn btn-outline-secondary" type="button" id="togglePass1">
                                <i class="bi bi-eye" id="eye1"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmarContrasena" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="ConfirmarContrasena" class="form-control"
                                   placeholder="Repita la contraseña"/>
                            <button class="btn btn-outline-secondary" type="button" id="togglePass2">
                                <i class="bi bi-eye" id="eye2"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                    </div>

                    <hr class="my-3"/>
                    <p class="fw-semibold text-muted small text-uppercase mb-2">Acceso</p>

                    <div class="mb-3">
                        <label asp-for="Rol" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield"></i></span>
                            <select asp-for="Rol" class="form-select">
                                <option value="Usuario">Estudiante</option>
                                <option value="Admin">Administrador</option>
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <option value="SuperAdmin">Administrador Principal</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="EsTrial" class="form-check-input" type="checkbox" role="switch" id="esTrialSwitch"/>
                            <label asp-for="EsTrial" class="form-check-label" for="esTrialSwitch">
                                Modo de prueba (Trial) — acceso limitado a un examen
                            </label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-check-lg me-2"></i>Crear Usuario
                        </button>
                        <a asp-action="Usuarios" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    function togglePwd(btnId, eyeId, inputId) {
        document.getElementById(btnId).addEventListener('click', function () {
            const inp  = document.getElementById(inputId);
            const icon = document.getElementById(eyeId);
            inp.type   = inp.type === 'password' ? 'text' : 'password';
            icon.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        });
    }
    togglePwd('togglePass1','eye1','Contrasena');
    togglePwd('togglePass2','eye2','ConfirmarContrasena');
</script>
}
