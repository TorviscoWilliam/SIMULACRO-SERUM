@model ConfiguracionCorreoViewModel
@{
    ViewData["Title"] = "Configuración de Correo";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-envelope-gear fs-4 text-primary"></i>
                    <div>
                        <h4 class="fw-bold mb-0">Configuración de Correo</h4>
                        <p class="text-muted small mb-0">
                            Parámetros SMTP para el envío de códigos de verificación y notificaciones.
                        </p>
                    </div>
                    @if (Model.YaConfigurado)
                    {
                        <span class="badge bg-success ms-auto">
                            <i class="bi bi-check-circle me-1"></i>Configurado
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark ms-auto">
                            <i class="bi bi-exclamation-triangle me-1"></i>Usando appsettings
                        </span>
                    }
                </div>
            </div>

            <div class="card-body p-4">

                @if (TempData["Exito"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
                        <i class="bi bi-check-circle me-1"></i>@TempData["Exito"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                        <i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="ConfiguracionCorreo" method="post" id="formConfig">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-8">
                            <label asp-for="Smtp" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-server"></i></span>
                                <input asp-for="Smtp" class="form-control" placeholder="smtp.gmail.com" />
                            </div>
                            <span asp-validation-for="Smtp" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-4">
                            <label asp-for="Puerto" class="form-label fw-semibold small"></label>
                            <input asp-for="Puerto" class="form-control" placeholder="587" inputmode="numeric" />
                            <span asp-validation-for="Puerto" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsuarioCorreo" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="UsuarioCorreo" class="form-control"
                                   placeholder="tucorreo@gmail.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="UsuarioCorreo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Contrasena" type="password" class="form-control"
                                   placeholder="@(Model.YaConfigurado ? "Dejar vacío para conservar la actual" : "App Password de Gmail")"
                                   autocomplete="new-password" id="inputContrasena" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePass">
                                <i class="bi bi-eye" id="eyePass"></i>
                            </button>
                        </div>
                        <div class="form-text text-muted">
                            Para Gmail usa una
                            <strong>App Password</strong> (Cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones).
                        </div>
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NombreRemitente" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                            <input asp-for="NombreRemitente" class="form-control"
                                   placeholder="Simulacro SERUMS" />
                        </div>
                        <span asp-validation-for="NombreRemitente" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="UsarSsl" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="UsarSsl" class="form-check-label fw-semibold small">Usar SSL / TLS</label>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-floppy me-2"></i>Guardar configuración
                        </button>
                        <button type="button" class="btn btn-outline-success"
                                data-bs-toggle="modal" data-bs-target="#modalPrueba">
                            <i class="bi bi-send me-1"></i>Probar envío
                        </button>
                    </div>
                </form>

            </div>
        </div>

        @if (!Model.YaConfigurado)
        {
            <div class="alert alert-info mt-3 small">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Sin configuración en BD.</strong>
                El sistema está usando los valores de <code>appsettings.json</code>.
                Guarda la configuración aquí para que tome efecto sin necesidad de redesplegar.
            </div>
        }

    </div>
</div>

@* Modal envío de prueba *@
<div class="modal fade" id="modalPrueba" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-send me-2 text-success"></i>Correo de prueba
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">
                    Envía un correo de prueba para verificar que la configuración SMTP funciona.
                    Usa la configuración <strong>actualmente guardada en BD</strong> (no la del formulario sin guardar).
                </p>
                <label class="form-label fw-semibold small">Correo de destino</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope-at"></i></span>
                    <input type="email" id="correoDestinoPrueba" class="form-control"
                           placeholder="destino@ejemplo.com" />
                </div>
                <div id="resultadoPrueba" class="mt-3 d-none"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-success btn-sm" id="btnEnviarPrueba">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="spinnerPrueba"></span>
                    <i class="bi bi-send me-1" id="iconPrueba"></i>Enviar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Toggle visibilidad contraseña
    document.getElementById('togglePass').addEventListener('click', function () {
        const inp  = document.getElementById('inputContrasena');
        const icon = document.getElementById('eyePass');
        inp.type       = inp.type === 'password' ? 'text' : 'password';
        icon.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
    });

    // Envío de correo de prueba vía AJAX
    document.getElementById('btnEnviarPrueba').addEventListener('click', async function () {
        const destino  = document.getElementById('correoDestinoPrueba').value.trim();
        const resultado= document.getElementById('resultadoPrueba');
        const spinner  = document.getElementById('spinnerPrueba');
        const icon     = document.getElementById('iconPrueba');

        resultado.className = 'mt-3 d-none';

        if (!destino) {
            resultado.className = 'mt-3 alert alert-warning small py-2';
            resultado.textContent = 'Ingresa un correo de destino.';
            return;
        }

        this.disabled = true;
        spinner.classList.remove('d-none');
        icon.classList.add('d-none');

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const resp  = await fetch('@Url.Action("ProbarCorreo", "Admin")', {
                method : 'POST',
                headers: {
                    'Content-Type'              : 'application/x-www-form-urlencoded',
                    'RequestVerificationToken'  : token
                },
                body: new URLSearchParams({ correoDestino: destino, __RequestVerificationToken: token })
            });
            const data = await resp.json();
            resultado.className = data.ok
                ? 'mt-3 alert alert-success small py-2'
                : 'mt-3 alert alert-danger small py-2';
            resultado.textContent = data.mensaje;
        } catch (e) {
            resultado.className = 'mt-3 alert alert-danger small py-2';
            resultado.textContent = 'Error de red al intentar enviar.';
        } finally {
            this.disabled = false;
            spinner.classList.add('d-none');
            icon.classList.remove('d-none');
        }
    });
</script>
}
