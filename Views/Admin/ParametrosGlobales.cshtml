@model SimulacroExamen.ViewModels.ParametrosGlobalesViewModel
@{
    ViewData["Title"] = "Parámetros globales";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-0">
            <i class="bi bi-sliders me-2 text-primary"></i>Parámetros globales
        </h2>
        <p class="text-muted mb-0">Configura tiempos y umbrales generales del sistema</p>
    </div>
    <span class="badge bg-danger fs-6 px-3 py-2">
        <i class="bi bi-shield-lock-fill me-1"></i>Solo SuperAdmin
    </span>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="ParametrosGlobales" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="TiempoMaximoSimulacroMinutos" class="form-label fw-semibold"></label>
                            <input asp-for="TiempoMaximoSimulacroMinutos" type="number" class="form-control" min="1" max="600" />
                            <div class="form-text">Se usa cuando un tipo de examen no tiene duración propia.</div>
                            <span asp-validation-for="TiempoMaximoSimulacroMinutos" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TiempoInactividadMinutos" class="form-label fw-semibold"></label>
                            <input asp-for="TiempoInactividadMinutos" type="number" class="form-control" min="5" max="480" />
                            <div class="form-text">Controla la expiración de sesión por inactividad.</div>
                            <span asp-validation-for="TiempoInactividadMinutos" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UmbralAprobacionPorcentaje" class="form-label fw-semibold"></label>
                            <input asp-for="UmbralAprobacionPorcentaje" type="number" class="form-control" min="0" max="100" />
                            <div class="form-text">Define cuándo un resultado se considera aprobado.</div>
                            <span asp-validation-for="UmbralAprobacionPorcentaje" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UmbralRegularPorcentaje" class="form-label fw-semibold"></label>
                            <input asp-for="UmbralRegularPorcentaje" type="number" class="form-control" min="0" max="100" />
                            <div class="form-text">Define el rango intermedio entre desaprobado y aprobado.</div>
                            <span asp-validation-for="UmbralRegularPorcentaje" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-info border-0 mt-4 small">
                        <i class="bi bi-info-circle me-1"></i>
                        Última actualización:
                        @(Model.FechaActualizacion.HasValue ? Model.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm") : "sin registro")
                        @if (!string.IsNullOrWhiteSpace(Model.AdminNombre))
                        {
                            <span>por <strong>@Model.AdminNombre</strong></span>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-2"></i>Guardar parámetros
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
