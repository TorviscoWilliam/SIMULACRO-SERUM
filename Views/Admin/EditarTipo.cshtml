@model SimulacroExamen.Models.TipoExamen
@{
    ViewData["Title"] = "Editar Tipo de Examen";
}

<div class="row justify-content-center">
    <div class="col-md-8">

        <!-- Datos generales -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-4">
                <h4 class="fw-bold mb-0">
                    <i class="bi bi-pencil-square me-2 text-warning"></i>Editar Tipo de Examen
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditarTipo" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id"/>
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control"/>
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label asp-for="NumeroPreguntas" class="form-label fw-semibold"></label>
                            <input asp-for="NumeroPreguntas" type="number" min="1" max="500"
                                   class="form-control"/>
                            <div class="form-text">Preguntas por defecto (si la opción no especifica otro valor).</div>
                            <span asp-validation-for="NumeroPreguntas" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="DuracionMinutos" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-clock"></i></span>
                                <input asp-for="DuracionMinutos" type="number" min="1" max="600"
                                       class="form-control" placeholder="Vacío = usar las opciones de abajo"/>
                                <span class="input-group-text">min</span>
                            </div>
                            <div class="form-text">Duración fija global. Las opciones de abajo tienen prioridad.</div>
                            <span asp-validation-for="DuracionMinutos" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning flex-fill">
                            <i class="bi bi-check-lg me-2"></i>Guardar Cambios
                        </button>
                        <a asp-action="TiposExamen" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Opciones de duración -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3 d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-clock-history me-2 text-info"></i>Opciones del Examen
                    </h5>
                    <p class="text-muted small mb-0">
                        El estudiante elige una de estas opciones al iniciar. Cada opción puede tener distinta cantidad de preguntas y duración.
                    </p>
                </div>
                <span class="badge bg-info-subtle text-info border border-info-subtle">
                    @Model.OpcionesDuracion.Count opción(es)
                </span>
            </div>
            <div class="card-body p-4">

                @if (TempData["Exito"] != null)
                {
                    <div class="alert alert-success py-2 small mb-3">
                        <i class="bi bi-check-circle me-1"></i>@TempData["Exito"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
                    </div>
                }

                <!-- Lista de opciones actuales -->
                @if (Model.OpcionesDuracion.Any())
                {
                    var ordenadas = Model.OpcionesDuracion.OrderBy(o => o.Orden).ToList();
                    <div class="list-group mb-4">
                        @for (int i = 0; i < ordenadas.Count; i++)
                        {
                            var op        = ordenadas[i];
                            var esPrimero = i == 0;
                            var esUltimo  = i == ordenadas.Count - 1;
                            <div class="list-group-item d-flex align-items-center gap-2 py-2 flex-wrap">
                                <i class="bi bi-stopwatch text-info fs-5"></i>
                                <div class="flex-grow-1">
                                    <span class="fw-semibold">@op.Etiqueta</span>
                                    @if (op.NumeroPreguntas > 0)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">
                                            @op.NumeroPreguntas pregs
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-1"
                                              title="Usa el número de preguntas del tipo (@Model.NumeroPreguntas)">
                                            @Model.NumeroPreguntas pregs <small>(def.)</small>
                                        </span>
                                    }
                                    <span class="badge @(op.DuracionMinutos == 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-info-subtle text-info border border-info-subtle") ms-1">
                                        @(op.DuracionMinutos == 0 ? "Sin tiempo" : op.DuracionMinutos + " min")
                                    </span>
                                </div>

                                <!-- Mover arriba / abajo -->
                                <form asp-action="MoverDuracion" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@op.Id"/>
                                    <input type="hidden" name="direccion" value="up"/>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            title="Mover arriba" @(esPrimero ? "disabled" : "")>
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                </form>
                                <form asp-action="MoverDuracion" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@op.Id"/>
                                    <input type="hidden" name="direccion" value="down"/>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            title="Mover abajo" @(esUltimo ? "disabled" : "")>
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                </form>

                                <!-- Editar -->
                                <button type="button" class="btn btn-sm btn-outline-warning btn-editar-duracion"
                                        data-bs-toggle="modal" data-bs-target="#modalEditarDuracion"
                                        data-id="@op.Id"
                                        data-etiqueta="@op.Etiqueta"
                                        data-minutos="@op.DuracionMinutos"
                                        data-numpreguntas="@op.NumeroPreguntas"
                                        title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <!-- Eliminar -->
                                <form asp-action="EliminarDuracion" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar la opción «@op.Etiqueta»?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@op.Id"/>
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border text-center py-3 mb-4">
                        <i class="bi bi-clock text-muted d-block fs-3 mb-1"></i>
                        <span class="text-muted small">
                            Sin opciones. Se usará la duración fija del tipo o sin tiempo.
                        </span>
                    </div>
                }

                <!-- Formulario para añadir nueva opción -->
                <div class="border rounded-3 p-3" style="background:#f8fbff">
                    <h6 class="fw-semibold mb-3 text-info">
                        <i class="bi bi-plus-circle me-2"></i>Agregar nueva opción de examen
                    </h6>
                    <form asp-action="AgregarDuracion" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tipoExamenId" value="@Model.Id"/>
                        <div class="row g-3 mb-3">
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold small">
                                    <i class="bi bi-card-list me-1 text-primary"></i>N° de Preguntas
                                </label>
                                <input type="number" id="new-pregs" name="numeroPreguntas"
                                       class="form-control"
                                       min="1" max="500" placeholder="Ej: 25, 50, 100" required/>
                                <div class="form-text">Cantidad de preguntas para esta opción.</div>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold small">
                                    <i class="bi bi-clock me-1 text-info"></i>Duración (minutos)
                                </label>
                                <div class="input-group">
                                    <input type="number" id="new-dur" name="duracionMinutos"
                                           class="form-control" min="0" max="600" value="0"/>
                                    <span class="input-group-text">min</span>
                                </div>
                                <div class="form-text"><strong>0</strong> = sin límite de tiempo.</div>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold small">
                                    <i class="bi bi-tag me-1 text-secondary"></i>Nombre / Etiqueta
                                </label>
                                <input type="text" id="new-etq" name="etiqueta"
                                       class="form-control" maxlength="100"
                                       placeholder="Se genera automáticamente" required/>
                                <div class="form-text">Texto que verá el estudiante.</div>
                            </div>
                        </div>

                        <!-- Vista previa de la tarjeta -->
                        <div class="d-flex align-items-center gap-2 rounded p-2 mb-3 bg-white border small">
                            <i class="bi bi-eye text-muted"></i>
                            <span class="text-muted">Vista previa del estudiante:</span>
                            <span id="prev-etq" class="fw-semibold text-dark">—</span>
                            <span id="prev-pregs-b" class="badge bg-primary-subtle text-primary border border-primary-subtle d-none"></span>
                            <span id="prev-dur-b"   class="badge d-none"></span>
                        </div>

                        <button type="submit" class="btn btn-info">
                            <i class="bi bi-plus-circle me-1"></i>Añadir opción
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal: Editar opción -->
<div class="modal fade" id="modalEditarDuracion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="EditarDuracion" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2 text-warning"></i>Editar opción
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    <input type="hidden" name="id" id="edit-id"/>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Etiqueta</label>
                        <input type="text" name="etiqueta" id="edit-etiqueta"
                               class="form-control" maxlength="100" required placeholder="Ej: 50 pregs / 30 min"/>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">N° Preguntas</label>
                            <input type="number" name="numeroPreguntas" id="edit-numpreguntas"
                                   class="form-control" min="0" max="500"/>
                            <div class="form-text small">0 = usa el default del tipo</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Duración (minutos)</label>
                            <div class="input-group">
                                <input type="number" name="duracionMinutos" id="edit-minutos"
                                       class="form-control" min="0" max="600"/>
                                <span class="input-group-text">min</span>
                            </div>
                            <div class="form-text small">0 = sin tiempo</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-lg me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Modal editar: poblar campos ──────────────────────────────
    document.querySelectorAll('.btn-editar-duracion').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('edit-id').value           = this.dataset.id;
            document.getElementById('edit-etiqueta').value     = this.dataset.etiqueta;
            document.getElementById('edit-minutos').value      = this.dataset.minutos;
            document.getElementById('edit-numpreguntas').value = this.dataset.numpreguntas;
        });
    });

    // ── Formulario nueva opción: auto-etiqueta + preview ────────
    var etqModificada = false;

    function construirEtiqueta(pregs, dur) {
        var durTxt = (dur === 0) ? 'Sin tiempo' : dur + ' min';
        return pregs > 0 ? (pregs + ' pregs / ' + durTxt) : durTxt;
    }

    function actualizarPreview() {
        var pregs = parseInt(document.getElementById('new-pregs').value) || 0;
        var dur   = parseInt(document.getElementById('new-dur').value);
        if (isNaN(dur)) dur = 0;

        // Auto-fill etiqueta si el admin no la tocó manualmente
        var etqInput = document.getElementById('new-etq');
        if (!etqModificada) {
            etqInput.value = pregs > 0 ? construirEtiqueta(pregs, dur) : '';
        }

        // Preview etiqueta
        document.getElementById('prev-etq').textContent = etqInput.value || '—';

        // Badge preguntas
        var pb = document.getElementById('prev-pregs-b');
        if (pregs > 0) {
            pb.textContent = pregs + ' pregs';
            pb.classList.remove('d-none');
        } else {
            pb.classList.add('d-none');
        }

        // Badge duración
        var db = document.getElementById('prev-dur-b');
        db.classList.remove('d-none',
            'bg-success-subtle','text-success','border-success-subtle',
            'bg-info-subtle','text-info','border-info-subtle');
        if (dur === 0) {
            db.textContent = 'Sin tiempo';
            db.classList.add('bg-success-subtle','text-success','border','border-success-subtle');
        } else {
            db.textContent = dur + ' min';
            db.classList.add('bg-info-subtle','text-info','border','border-info-subtle');
        }
    }

    document.getElementById('new-pregs').addEventListener('input', actualizarPreview);
    document.getElementById('new-dur').addEventListener('input', actualizarPreview);
    document.getElementById('new-etq').addEventListener('input', function () {
        etqModificada = this.value.trim() !== construirEtiqueta(
            parseInt(document.getElementById('new-pregs').value) || 0,
            parseInt(document.getElementById('new-dur').value) || 0
        );
        actualizarPreview();
    });
</script>
}
