@model SimulacroExamen.Models.TipoExamen
@{
    ViewData["Title"] = "Editar Tipo de Examen";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <!-- Datos generales -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-4">
                <h4 class="fw-bold mb-0">
                    <i class="bi bi-pencil-square me-2 text-warning"></i>Editar Tipo de Examen
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditarTipo" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id"/>
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control"/>
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NumeroPreguntas" class="form-label fw-semibold"></label>
                        <input asp-for="NumeroPreguntas" type="number" min="1" max="200"
                               class="form-control"/>
                        <div class="form-text">Cantidad de preguntas aleatorias por examen.</div>
                        <span asp-validation-for="NumeroPreguntas" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DuracionMinutos" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-clock"></i></span>
                            <input asp-for="DuracionMinutos" type="number" min="1" max="600"
                                   class="form-control" placeholder="Dejar vacío para usar las opciones de abajo"/>
                            <span class="input-group-text">min</span>
                        </div>
                        <div class="form-text">
                            Duración fija para todos los modos. Si configuras opciones múltiples abajo, éstas tienen prioridad.
                        </div>
                        <span asp-validation-for="DuracionMinutos" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning flex-fill">
                            <i class="bi bi-check-lg me-2"></i>Guardar Cambios
                        </button>
                        <a asp-action="TiposExamen" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Opciones de duración -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3 d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-clock-history me-2 text-info"></i>Opciones de Duración
                    </h5>
                    <p class="text-muted small mb-0">
                        El estudiante elegirá entre estas opciones al iniciar el examen.
                    </p>
                </div>
                <span class="badge bg-info-subtle text-info border border-info-subtle">
                    @Model.OpcionesDuracion.Count opción(es)
                </span>
            </div>
            <div class="card-body p-4">

                @if (TempData["Exito"] != null)
                {
                    <div class="alert alert-success py-2 small mb-3">
                        <i class="bi bi-check-circle me-1"></i>@TempData["Exito"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
                    </div>
                }

                <!-- Lista de opciones actuales -->
                @if (Model.OpcionesDuracion.Any())
                {
                    var ordenadas = Model.OpcionesDuracion.OrderBy(o => o.Orden).ToList();
                    <div class="list-group mb-4">
                        @for (int i = 0; i < ordenadas.Count; i++)
                        {
                            var op      = ordenadas[i];
                            var esPrimero = i == 0;
                            var esUltimo  = i == ordenadas.Count - 1;
                            <div class="list-group-item d-flex align-items-center gap-2 py-2 flex-wrap">
                                <i class="bi bi-stopwatch text-info fs-5"></i>
                                <div class="flex-grow-1">
                                    <span class="fw-semibold">@op.Etiqueta</span>
                                    <span class="text-muted small ms-2">— @op.DuracionMinutos minutos</span>
                                </div>

                                <!-- Mover arriba / abajo -->
                                <form asp-action="MoverDuracion" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@op.Id"/>
                                    <input type="hidden" name="direccion" value="up"/>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            title="Mover arriba" @(esPrimero ? "disabled" : "")>
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                </form>
                                <form asp-action="MoverDuracion" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@op.Id"/>
                                    <input type="hidden" name="direccion" value="down"/>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            title="Mover abajo" @(esUltimo ? "disabled" : "")>
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                </form>

                                <!-- Editar -->
                                <button type="button" class="btn btn-sm btn-outline-warning btn-editar-duracion"
                                        data-bs-toggle="modal" data-bs-target="#modalEditarDuracion"
                                        data-id="@op.Id"
                                        data-etiqueta="@op.Etiqueta"
                                        data-minutos="@op.DuracionMinutos"
                                        title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <!-- Eliminar -->
                                <form asp-action="EliminarDuracion" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar la opción «@op.Etiqueta»?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@op.Id"/>
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border text-center py-3 mb-4">
                        <i class="bi bi-clock text-muted d-block fs-3 mb-1"></i>
                        <span class="text-muted small">
                            Sin opciones configuradas. El tiempo se tomará de la duración fija o se calculará automáticamente.
                        </span>
                    </div>
                }

                <!-- Formulario para añadir nueva opción -->
                <form asp-action="AgregarDuracion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tipoExamenId" value="@Model.Id"/>
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-5">
                            <label class="form-label fw-semibold small">Etiqueta</label>
                            <input type="text" name="etiqueta" class="form-control form-control-sm"
                                   placeholder="Ej: 30 minutos, 1 hora, 2 horas" maxlength="100"/>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label fw-semibold small">Duración (min)</label>
                            <div class="input-group input-group-sm">
                                <input type="number" name="duracionMinutos" class="form-control"
                                       min="1" max="600" placeholder="30"/>
                                <span class="input-group-text">min</span>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <button type="submit" class="btn btn-info btn-sm w-100">
                                <i class="bi bi-plus-circle me-1"></i>Añadir
                            </button>
                        </div>
                    </div>
                    <div class="form-text mt-1">
                        Ejemplos: "30 minutos" = 30, "1 hora" = 60, "2 horas" = 120, "Sin límite" = 0 (no recomendado).
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

<!-- Modal: Editar opción de duración -->
<div class="modal fade" id="modalEditarDuracion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="EditarDuracion" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2 text-warning"></i>Editar opción de duración
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    <input type="hidden" name="id" id="edit-duracion-id"/>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Etiqueta</label>
                        <input type="text" name="etiqueta" id="edit-duracion-etiqueta"
                               class="form-control" maxlength="100" required
                               placeholder="Ej: 1 hora"/>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold small">Duración (minutos)</label>
                        <div class="input-group">
                            <input type="number" name="duracionMinutos" id="edit-duracion-minutos"
                                   class="form-control" min="1" max="600" required/>
                            <span class="input-group-text">min</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-lg me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.btn-editar-duracion').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('edit-duracion-id').value       = this.dataset.id;
            document.getElementById('edit-duracion-etiqueta').value = this.dataset.etiqueta;
            document.getElementById('edit-duracion-minutos').value  = this.dataset.minutos;
        });
    });
</script>
}
