@model SimulacroExamen.Models.AnuncioGlobal?
@{
    ViewData["Title"] = "Anuncio Global";
    bool activo  = Model?.Activo ?? false;
    string tipo  = Model?.Tipo   ?? "warning";
    string msg   = Model?.Mensaje ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">
            <i class="bi bi-megaphone-fill me-2 text-primary"></i>Anuncio Global
        </h2>
        <p class="text-muted mb-0">Banner de mantenimiento o aviso visible para todos los usuarios</p>
    </div>
    <span class="badge fs-6 @(activo ? "bg-success" : "bg-secondary")">
        <i class="bi @(activo ? "bi-broadcast" : "bi-broadcast-pin") me-1"></i>
        @(activo ? "Activo" : "Inactivo")
    </span>
</div>

<!-- Vista previa del banner actual -->
@if (activo && !string.IsNullOrEmpty(msg))
{
    <div class="mb-4">
        <p class="text-muted small fw-semibold mb-2">
            <i class="bi bi-eye me-1"></i>Vista previa del banner actual:
        </p>
        <div class="alert alert-@tipo d-flex align-items-center gap-3 mb-0 shadow-sm" role="alert">
            <i class="bi @(tipo == "danger" ? "bi-exclamation-octagon-fill" :
                           tipo == "warning" ? "bi-exclamation-triangle-fill" :
                           tipo == "success" ? "bi-check-circle-fill" :
                           "bi-info-circle-fill") fs-5 flex-shrink-0"></i>
            <span>@msg</span>
        </div>
    </div>
}

<!-- Formulario -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3">
        <h5 class="fw-bold mb-0">
            <i class="bi bi-pencil-square me-2 text-primary"></i>Configurar Anuncio
        </h5>
    </div>
    <div class="card-body p-4">
        <form asp-action="AnuncioGlobal" method="post">
            @Html.AntiForgeryToken()

            <!-- Mensaje -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    Mensaje del anuncio <span class="text-danger">*</span>
                </label>
                <textarea name="mensaje" class="form-control" rows="3"
                          maxlength="500" placeholder="Ej: El sistema estará en mantenimiento el sábado 15 de marzo de 2:00 a.m. a 4:00 a.m."
                          required>@msg</textarea>
                <div class="form-text text-end" id="charCount">
                    <span id="charCurrent">@msg.Length</span>/500 caracteres
                </div>
            </div>

            <!-- Tipo de alerta -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Tipo de alerta</label>
                <div class="row g-3">

                    <div class="col-6 col-md-3">
                        <label class="tipo-card w-100 cursor-pointer">
                            <input type="radio" name="tipo" value="info" class="d-none"
                                   @(tipo == "info" ? "checked" : "") />
                            <div class="card border-2 p-3 text-center h-100
                                        @(tipo == "info" ? "border-primary bg-primary-subtle" : "border-light")">
                                <i class="bi bi-info-circle-fill text-primary fs-4 mb-1 d-block"></i>
                                <span class="small fw-semibold">Informativo</span>
                                <div class="demo-bar mt-2 rounded" style="height:6px;background:#0d6efd;opacity:.4"></div>
                            </div>
                        </label>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="tipo-card w-100 cursor-pointer">
                            <input type="radio" name="tipo" value="warning" class="d-none"
                                   @(tipo == "warning" ? "checked" : "") />
                            <div class="card border-2 p-3 text-center h-100
                                        @(tipo == "warning" ? "border-warning bg-warning-subtle" : "border-light")">
                                <i class="bi bi-exclamation-triangle-fill text-warning fs-4 mb-1 d-block"></i>
                                <span class="small fw-semibold">Advertencia</span>
                                <div class="demo-bar mt-2 rounded" style="height:6px;background:#ffc107;opacity:.6"></div>
                            </div>
                        </label>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="tipo-card w-100 cursor-pointer">
                            <input type="radio" name="tipo" value="danger" class="d-none"
                                   @(tipo == "danger" ? "checked" : "") />
                            <div class="card border-2 p-3 text-center h-100
                                        @(tipo == "danger" ? "border-danger bg-danger-subtle" : "border-light")">
                                <i class="bi bi-exclamation-octagon-fill text-danger fs-4 mb-1 d-block"></i>
                                <span class="small fw-semibold">Urgente</span>
                                <div class="demo-bar mt-2 rounded" style="height:6px;background:#dc3545;opacity:.5"></div>
                            </div>
                        </label>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="tipo-card w-100 cursor-pointer">
                            <input type="radio" name="tipo" value="success" class="d-none"
                                   @(tipo == "success" ? "checked" : "") />
                            <div class="card border-2 p-3 text-center h-100
                                        @(tipo == "success" ? "border-success bg-success-subtle" : "border-light")">
                                <i class="bi bi-check-circle-fill text-success fs-4 mb-1 d-block"></i>
                                <span class="small fw-semibold">Éxito / Info positiva</span>
                                <div class="demo-bar mt-2 rounded" style="height:6px;background:#198754;opacity:.5"></div>
                            </div>
                        </label>
                    </div>

                </div>
            </div>

            <!-- Estado -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Estado del anuncio</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="activo"
                               id="activoSi" value="true" @(activo ? "checked" : "") />
                        <label class="form-check-label fw-semibold text-success" for="activoSi">
                            <i class="bi bi-broadcast me-1"></i>Activar (visible para usuarios)
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="activo"
                               id="activoNo" value="false" @(!activo ? "checked" : "") />
                        <label class="form-check-label fw-semibold text-secondary" for="activoNo">
                            <i class="bi bi-eye-slash me-1"></i>Desactivar (oculto)
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-2"></i>Guardar cambios
                </button>
                @if (activo)
                {
                    <button type="submit" class="btn btn-outline-danger px-4"
                            onclick="document.querySelector('#activoNo').checked=true">
                        <i class="bi bi-eye-slash me-2"></i>Desactivar ahora
                    </button>
                }
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
    // Contador de caracteres
    const textarea = document.querySelector('textarea[name="mensaje"]');
    const counter  = document.getElementById('charCurrent');
    textarea.addEventListener('input', function () {
        counter.textContent = this.value.length;
    });

    // Selección visual de tipo
    document.querySelectorAll('.tipo-card').forEach(function (lbl) {
        lbl.addEventListener('click', function () {
            const radio = this.querySelector('input[type=radio]');
            const colorMap = { info: 'primary', warning: 'warning', danger: 'danger', success: 'success' };
            const color = colorMap[radio.value];

            document.querySelectorAll('.tipo-card .card').forEach(function (c) {
                c.className = c.className
                    .replace(/border-(primary|warning|danger|success)\s*/g, '')
                    .replace(/bg-(primary|warning|danger|success)-subtle\s*/g, '');
                c.classList.add('border-light');
            });

            const card = this.querySelector('.card');
            card.classList.remove('border-light');
            card.classList.add('border-' + color, 'bg-' + color + '-subtle');
        });
    });
</script>
}
