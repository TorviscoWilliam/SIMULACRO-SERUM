@model List<SimulacroExamen.ViewModels.NoticiaListaVM>
@{
    ViewData["Title"] = "Noticias y Anuncios";
    int page       = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-megaphone me-2 text-primary"></i>Noticias y Anuncios</h2>
        <p class="text-muted mb-0">Información publicada por el equipo</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-newspaper fs-1 d-block mb-2 text-secondary"></i>
        <p class="mb-0">No hay noticias publicadas por el momento.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var n in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    @if (!string.IsNullOrEmpty(n.ImagenRuta))
                    {
                        <img src="@n.ImagenRuta" class="card-img-top object-fit-cover img-fluid" style="height:200px;max-height:200px" alt="@n.Titulo" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="fw-bold card-title">@n.Titulo</h5>
                        <p class="card-text text-muted flex-grow-1" style="white-space:pre-line">@n.Contenido</p>
                        @if (!string.IsNullOrEmpty(n.EnlaceUrl) &&
                             (n.EnlaceUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
                              n.EnlaceUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)))
                        {
                            <div class="mt-3">
                                <a href="@n.EnlaceUrl" target="_blank" rel="noopener noreferrer"
                                   class="btn btn-primary w-100">
                                    <i class="bi bi-box-arrow-up-right me-2"></i>Ver más información
                                </a>
                            </div>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-3 small text-muted">
                            <span><i class="bi bi-person me-1"></i>@n.AdminNombre</span>
                            <span><i class="bi bi-calendar me-1"></i>@n.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Noticias" asp-route-page="@(page - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" asp-action="Noticias" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Noticias" asp-route-page="@(page + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
