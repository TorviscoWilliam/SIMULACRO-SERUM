@model List<Examen>
@{
    ViewData["Title"] = "Mi Historial";
    int total    = Model.Count;
    double mejor = total > 0 ? Model.Max(e => e.Porcentaje) : 0;
    double prom  = total > 0 ? Model.Average(e => e.Porcentaje) : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-success"></i>Mi Historial</h2>
        <p class="text-muted mb-0">@total examen(es) completado(s)</p>
    </div>
    <form asp-action="IniciarExamen" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-play-fill me-2"></i>Nuevo Examen
        </button>
    </form>
</div>

@if (total > 0)
{
    <!-- Resumen estadístico -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fw-bold fs-2 text-primary">@total</div>
                <div class="text-muted small">Total Exámenes</div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fw-bold fs-2 text-warning">@mejor.ToString("0.0")%</div>
                <div class="text-muted small">Mejor Puntaje</div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fw-bold fs-2 text-info">@prom.ToString("0.0")%</div>
                <div class="text-muted small">Promedio</div>
            </div>
        </div>
    </div>

    <!-- Tabla de historial -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Fecha</th>
                        <th>Duración</th>
                        <th class="text-center">Puntaje</th>
                        <th class="text-center">Porcentaje</th>
                        <th class="text-center">Resultado</th>
                        <th class="text-center">Revisión</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var e   = Model[i];
                        var dur = e.FechaFin.HasValue ? (e.FechaFin.Value - e.FechaInicio) : TimeSpan.Zero;
                        string badge = e.Porcentaje >= 70 ? "bg-success"
                                     : e.Porcentaje >= 50 ? "bg-warning"
                                     : "bg-danger";

                        <tr>
                            <td class="text-muted small">@(i + 1)</td>
                            <td>
                                <div class="fw-semibold small">@e.FechaInicio.ToString("dd/MM/yyyy")</div>
                                <div class="text-muted small">@e.FechaInicio.ToString("HH:mm")</div>
                            </td>
                            <td class="small">
                                @((int)dur.TotalMinutes)m @dur.Seconds s
                            </td>
                            <td class="text-center fw-bold">
                                @e.Puntaje / @e.TotalPreguntas
                            </td>
                            <td class="text-center">
                                <div class="fw-bold">@e.Porcentaje.ToString("0.0")%</div>
                                <div class="progress mt-1" style="height:4px">
                                    <div class="progress-bar @badge"
                                         style="width:@e.Porcentaje.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%">
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge @badge rounded-pill px-3">
                                    @(e.Porcentaje >= 70 ? "Aprobado" : e.Porcentaje >= 50 ? "Regular" : "Desaprobado")
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Resultado" asp-route-id="@e.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-journal-x text-muted" style="font-size:5rem"></i>
        <h4 class="mt-3 text-muted">Aún no has tomado ningún examen</h4>
        <p class="text-muted">¡Toma tu primer examen y comienza a practicar!</p>
        <form asp-action="IniciarExamen" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-play-fill me-2"></i>Tomar mi primer examen
            </button>
        </form>
    </div>
}
