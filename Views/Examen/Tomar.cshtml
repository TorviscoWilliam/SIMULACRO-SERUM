@model ExamenViewModel
@{
    ViewData["Title"] = "Examen en Curso";
    Layout = "_Layout";
    int totalPregs   = Model.Preguntas.Count;
    bool sinTiempo   = ViewBag.SegundosRestantes == null;
    int segRestantes = sinTiempo ? 0 : (int)ViewBag.SegundosRestantes;
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <!-- Encabezado -->
        <div class="card border-0 shadow-sm mb-3 border-start border-primary border-4">
            <div class="card-body py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-journal-text me-2 text-primary"></i>
                        @(!string.IsNullOrEmpty(Model.TipoExamenNombre) ? Model.TipoExamenNombre : "Simulacro de Examen")
                    </h5>
                    <p class="text-muted small mb-0">@totalPregs pregunta(s)</p>
                </div>
                @if (sinTiempo)
                {
                    <div id="timerBox" class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6">
                        <i class="bi bi-infinity me-1"></i>Sin límite de tiempo
                    </div>
                }
                else
                {
                    <div id="timerBox" class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
                        <i class="bi bi-stopwatch me-1"></i>
                        <span id="cronometro">--:--</span>
                    </div>
                }
            </div>
        </div>

        <!-- Botones de navegación rápida -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-2 px-3">
                <div class="d-flex flex-wrap gap-1 align-items-center">
                    <span class="text-muted small me-2">Ir a:</span>
                    @for (int i = 0; i < totalPregs; i++)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary nav-num"
                                id="navBtn_@i"
                                onclick="irPregunta(@i)">@(i + 1)</button>
                    }
                </div>
            </div>
        </div>

        <!-- Barra de progreso -->
        <div class="mb-3">
            <div class="d-flex justify-content-between small text-muted mb-1">
                <span id="progTexto">0 / @totalPregs respondidas</span>
                <span id="contadorPregunta">Pregunta 1 de @totalPregs</span>
            </div>
            <div class="progress" style="height:8px">
                <div class="progress-bar bg-primary" id="barraProgreso" style="width:0%"></div>
            </div>
        </div>

        <!-- Formulario del examen -->
        <form id="formExamen" asp-controller="Examen" asp-action="Enviar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ExamenId" value="@Model.ExamenId"/>

            @for (int i = 0; i < totalPregs; i++)
            {
                var pvm = Model.Preguntas[i];
                <div class="card border-0 shadow-sm mb-3 pregunta-card @(i == 0 ? "" : "d-none")"
                     id="card_@i">
                    <div class="card-body p-4">
                        <div class="d-flex gap-3 mb-3">
                            <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                  style="width:2rem;height:2rem;font-size:.85rem">@(i + 1)</span>
                            <p class="fw-semibold mb-0 fs-6">@pvm.TextoPregunta</p>
                        </div>
                        <div class="ps-5">
                            @foreach (var alt in pvm.Alternativas)
                            {
                                bool preSeleccionada = pvm.AlternativaSeleccionadaId == alt.Id;
                                <div class="form-check alternativa-item mb-2">
                                    <input class="form-check-input respuesta-radio"
                                           type="radio"
                                           name="respuesta_@pvm.PreguntaExamenId"
                                           id="alt_@alt.Id"
                                           value="@alt.Id"
                                           data-peId="@pvm.PreguntaExamenId"
                                           data-idx="@i"
                                           @(preSeleccionada ? "checked" : "")
                                           onchange="marcarRespondida(@i, this)"/>
                                    <label class="form-check-label alternativa-label w-100 p-2 rounded @(preSeleccionada ? "seleccionada" : "")"
                                           for="alt_@alt.Id">
                                        @alt.TextoAlternativa
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Controles de navegación Anterior / Enviar / Siguiente -->
            <div class="d-flex align-items-center justify-content-between mt-3 gap-2">
                <button type="button" id="btnAnterior" class="btn btn-outline-secondary"
                        onclick="navAnterior()" disabled>
                    <i class="bi bi-arrow-left me-1"></i>Anterior
                </button>

                <button type="button" class="btn btn-success px-4"
                        data-bs-toggle="modal" data-bs-target="#modalEnviar"
                        onclick="prepararModal()">
                    <i class="bi bi-send me-2"></i>Enviar Examen
                </button>

                <button type="button" id="btnSiguiente" class="btn btn-primary"
                        onclick="navSiguiente()">
                    Siguiente<i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </form>

    </div>
</div>

<!-- ── Modal: confirmar envío ──────────────────────────────────── -->
<div class="modal fade" id="modalEnviar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-send me-2 text-success"></i>Enviar Examen
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p id="modalMensaje" class="mb-2"></p>
                <div id="modalAdvertencia" class="alert alert-warning py-2 small d-none">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <span id="modalAdvertenciaTexto"></span>
                </div>
                <p class="text-muted small mb-0">
                    Una vez enviado, no podrás modificar tus respuestas.
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-pencil me-1"></i>Seguir Revisando
                </button>
                <button type="button" class="btn btn-success" onclick="enviarExamen()">
                    <i class="bi bi-check-lg me-1"></i>Confirmar Envío
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal: alerta 15 minutos ────────────────────────────────── -->
<div class="modal fade" id="modalAlerta15" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 border-top border-warning border-3 shadow">
            <div class="modal-body text-center py-4">
                <i class="bi bi-alarm text-warning d-block mb-3" style="font-size:3rem"></i>
                <h5 class="fw-bold">¡Solo quedan 15 minutos!</h5>
                <p class="text-muted mb-0">
                    El examen se enviará automáticamente al terminar el tiempo.
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-warning px-4" data-bs-dismiss="modal">
                    Entendido
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal: alerta 5 minutos ─────────────────────────────────── -->
<div class="modal fade" id="modalAlerta5" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 border-top border-danger border-3 shadow">
            <div class="modal-body text-center py-4">
                <i class="bi bi-exclamation-triangle-fill text-danger d-block mb-3" style="font-size:3rem"></i>
                <h5 class="fw-bold text-danger">¡Solo quedan 5 minutos!</h5>
                <p class="text-muted mb-0">
                    Revisa tus respuestas y envía el examen antes de que se acabe el tiempo.
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-danger px-4" data-bs-dismiss="modal">
                    Entendido
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const TOTAL_PREGS  = @totalPregs;
    const CSRF_TOKEN   = document.querySelector('input[name="__RequestVerificationToken"]').value;
    let respondidas    = new Array(TOTAL_PREGS).fill(false);
    let preguntaActual = 0;
    let examEnviado    = false;

    // ── Inicializar respuestas pre-guardadas ─────────────────────
    document.querySelectorAll('.respuesta-radio:checked').forEach(radio => {
        const idx = parseInt(radio.dataset.idx);
        respondidas[idx] = true;
        const label = radio.nextElementSibling;
        if (label) label.classList.add('seleccionada');
    });

    // ── Navegación ───────────────────────────────────────────────
    function irPregunta(idx) {
        document.getElementById('card_' + preguntaActual).classList.add('d-none');
        preguntaActual = idx;
        document.getElementById('card_' + preguntaActual).classList.remove('d-none');
        actualizarUI();
    }
    function navAnterior() { if (preguntaActual > 0) irPregunta(preguntaActual - 1); }
    function navSiguiente() { if (preguntaActual < TOTAL_PREGS - 1) irPregunta(preguntaActual + 1); }

    function actualizarUI() {
        document.getElementById('btnAnterior').disabled  = (preguntaActual === 0);
        document.getElementById('btnSiguiente').disabled = (preguntaActual === TOTAL_PREGS - 1);
        document.getElementById('contadorPregunta').textContent =
            'Pregunta ' + (preguntaActual + 1) + ' de ' + TOTAL_PREGS;

        const totalResp = respondidas.filter(Boolean).length;
        document.getElementById('barraProgreso').style.width = (totalResp / TOTAL_PREGS * 100) + '%';
        document.getElementById('progTexto').textContent = totalResp + ' / ' + TOTAL_PREGS + ' respondidas';

        document.querySelectorAll('.nav-num').forEach((btn, idx) => {
            btn.className = 'btn btn-sm nav-num ' + (
                idx === preguntaActual ? 'btn-primary' :
                respondidas[idx]      ? 'btn-success'  :
                                        'btn-outline-secondary'
            );
        });
    }

    // ── Auto-guardar respuesta via AJAX ──────────────────────────
    function guardarRespuesta(preguntaExamenId, alternativaId) {
        const body = new URLSearchParams({
            preguntaExamenId: preguntaExamenId,
            alternativaId:    alternativaId,
            __RequestVerificationToken: CSRF_TOKEN
        });
        fetch('/Examen/GuardarRespuesta', { method: 'POST', body: body })
            .catch(() => {}); // silencioso — el usuario no debe ver errores de guardado
    }

    // ── Al seleccionar respuesta ─────────────────────────────────
    function marcarRespondida(idx, radio) {
        respondidas[idx] = true;

        // Resaltar alternativa seleccionada
        const card = document.getElementById('card_' + idx);
        card.querySelectorAll('.alternativa-label').forEach(l => l.classList.remove('seleccionada'));
        card.querySelectorAll('.respuesta-radio').forEach(r => {
            if (r.checked) r.nextElementSibling.classList.add('seleccionada');
        });

        actualizarUI();

        // Auto-guardar en BD
        if (radio) guardarRespuesta(radio.dataset.peId, radio.value);

        // Avanzar automáticamente a la siguiente pregunta (pequeño delay)
        if (idx < TOTAL_PREGS - 1) setTimeout(() => irPregunta(idx + 1), 350);
    }

    // ── Modal de envío ───────────────────────────────────────────
    function prepararModal() {
        const totalResp = respondidas.filter(Boolean).length;
        const falta = TOTAL_PREGS - totalResp;
        document.getElementById('modalMensaje').textContent =
            'Has respondido ' + totalResp + ' de ' + TOTAL_PREGS + ' preguntas.';
        if (falta > 0) {
            document.getElementById('modalAdvertencia').classList.remove('d-none');
            document.getElementById('modalAdvertenciaTexto').textContent =
                falta + ' pregunta(s) sin responder contarán como incorrectas.';
        } else {
            document.getElementById('modalAdvertencia').classList.add('d-none');
        }
    }

    function enviarExamen() {
        examEnviado = true;
        if (crono) clearInterval(crono);
        document.getElementById('formExamen').submit();
    }

    // ── Temporizador regresivo ───────────────────────────────────
    const SIN_TIEMPO    = @(sinTiempo ? "true" : "false");
    let segundos        = @segRestantes;
    const ALERTA15_SEG  = 15 * 60;
    const ALERTA5_SEG   = 5 * 60;
    let alerta15Mostrada = false;
    let alerta5Mostrada  = false;
    let crono           = null;

    function formatTiempo(s) {
        return String(Math.floor(s / 60)).padStart(2,'0') + ':' +
               String(s % 60).padStart(2,'0');
    }

    if (!SIN_TIEMPO) {
        document.getElementById('cronometro').textContent = formatTiempo(segundos);

        crono = setInterval(() => {
            if (segundos <= 0) {
                clearInterval(crono);
                examEnviado = true;
                document.getElementById('formExamen').submit();
                return;
            }
            segundos--;
            document.getElementById('cronometro').textContent = formatTiempo(segundos);

            // Alerta a 15 minutos restantes
            if (segundos === ALERTA15_SEG && !alerta15Mostrada) {
                alerta15Mostrada = true;
                new bootstrap.Modal(document.getElementById('modalAlerta15')).show();
            }

            // Alerta a 5 minutos restantes
            if (segundos === ALERTA5_SEG && !alerta5Mostrada) {
                alerta5Mostrada = true;
                new bootstrap.Modal(document.getElementById('modalAlerta5')).show();
            }

            // Cambiar color del temporizador
            const box = document.getElementById('timerBox');
            if (segundos <= ALERTA5_SEG) {
                box.className = 'badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fs-6';
            } else if (segundos <= ALERTA15_SEG) {
                box.className = 'badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 fs-6';
            }
        }, 1000);
    }

    // Advertencia al cerrar pestaña/navegar fuera
    window.addEventListener('beforeunload', function (e) {
        if (!examEnviado) { e.preventDefault(); e.returnValue = ''; }
    });

    // Inicializar
    actualizarUI();
</script>
}
