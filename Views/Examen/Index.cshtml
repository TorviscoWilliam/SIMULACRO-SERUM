@{
    ViewData["Title"] = "Inicio";
    var totalExamenes     = (int)ViewBag.TotalExamenes;
    var mejorPuntaje      = (double)ViewBag.MejorPuntaje;
    var tiposAcceso       = (List<SimulacroExamen.Models.TipoExamen>)ViewBag.TiposAcceso;
    var planesSuscripcion = (List<SimulacroExamen.Models.PlanSuscripcion>)(ViewBag.PlanesSuscripcion ?? new List<SimulacroExamen.Models.PlanSuscripcion>());
    var pregsPorTipo      = (Dictionary<int, int>)ViewBag.PreguntasPorTipo;
    var intentosHoy       = (int)ViewBag.IntentosHoy;
    var intentosRest      = (int)ViewBag.IntentosRestantes;
    var graficaFechas     = (List<string>)ViewBag.GraficaFechas;
    var graficaPorcentajes = (List<double>)ViewBag.GraficaPorcentajes;
    bool hayGrafica       = graficaFechas != null && graficaFechas.Count > 1;
    bool esTrial          = (bool)(ViewBag.EsTrial ?? false);
    bool trialAgotado     = (bool)(ViewBag.TrialAgotado ?? false);
    int examenesCompletados = (int)(ViewBag.ExamenesCompletados ?? 0);
    bool suscripcionVencida = (bool)(ViewBag.SuscripcionVencida ?? false);
    int  diasRestantes      = (int)(ViewBag.DiasRestantes ?? 0);
    bool proximoAVencer     = (bool)(ViewBag.ProximoAVencer ?? false);
    var  fechaVencimiento   = ViewBag.FechaVencimiento as DateTime?;
}

<div class="row justify-content-center">
    <div class="col-lg-10">

        <!-- Bienvenida -->
        <div class="card border-0 shadow-sm mb-4 bg-primary text-white">
            <div class="card-body py-4 px-4 d-flex align-items-center gap-4">
                <div>
                    <i class="bi bi-person-circle" style="font-size:4rem;opacity:.9"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1">¡Bienvenido, @User.Identity!.Name!</h3>
                    <p class="mb-0 opacity-75">
                        Selecciona el tipo de examen que deseas practicar.
                        Cada intento queda registrado y podrás revisar tus respuestas al finalizar.
                    </p>
                </div>
            </div>
        </div>

        <!-- Banner examen en progreso (reanudable) -->
        @if (ViewBag.ExamenEnCurso != null)
        {
            var enc = ViewBag.ExamenEnCurso;
            var tiempoTranscurrido = (DateTime.Now - (DateTime)enc.FechaInicio);
            var minutos = (int)tiempoTranscurrido.TotalMinutes;
            var tiempoTexto = minutos < 60 ? $"hace {minutos} min" : $"hace {(int)(tiempoTranscurrido.TotalHours):0}h {minutos % 60}min";
            <div class="card border-0 shadow mb-4" style="border-left:5px solid #0d6efd !important;background:linear-gradient(135deg,#dbeafe,#eff6ff);">
                <div class="card-body py-3 px-4 d-flex align-items-center gap-3 flex-wrap">
                    <div class="flex-shrink-0 text-primary">
                        <i class="bi bi-journal-arrow-up" style="font-size:2.5rem"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold text-primary mb-1">
                            <i class="bi bi-play-circle-fill me-1"></i>Tienes un examen en progreso
                        </h6>
                        <p class="mb-0 small text-dark">
                            <strong>@enc.TipoNombre</strong> —
                            <span class="text-muted">Iniciado @tiempoTexto</span> ·
                            <strong>@enc.RespuestasDadas / @enc.TotalPreguntas</strong> preguntas respondidas
                            @if (enc.DuracionSegundos != null)
                            {
                                var restSeg = Math.Max(0, (int)enc.DuracionSegundos - (int)(DateTime.Now - (DateTime)enc.FechaInicio).TotalSeconds);
                                var restMin = restSeg / 60;
                                <span class="badge bg-warning text-dark ms-1">
                                    <i class="bi bi-clock me-1"></i>@restMin min restantes
                                </span>
                            }
                        </p>
                    </div>
                    <div class="d-flex gap-2 flex-shrink-0 flex-wrap">
                        <a href="@Url.Action("Tomar", "Examen", new { id = (int)enc.Id })"
                           class="btn btn-primary fw-bold">
                            <i class="bi bi-play-fill me-1"></i>Reanudar
                        </a>
                        <form asp-action="AbandonarExamen" method="post" class="d-inline"
                              onsubmit="return confirm('¿Seguro que quieres descartar este examen? Se perderán las respuestas guardadas.')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@((int)enc.Id)" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash me-1"></i>Descartar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }

        <!-- Banner modo trial -->
        @if (esTrial)
        {
            @if (trialAgotado)
            {
                <div class="card border-0 shadow mb-4" style="background:linear-gradient(135deg,#dc3545 0%,#a71d2a 100%);color:#fff;">
                    <div class="card-body py-4 px-4 d-flex align-items-center gap-4 flex-wrap">
                        <div class="flex-shrink-0 text-center" style="min-width:60px">
                            <i class="bi bi-lock-fill" style="font-size:3rem;opacity:.9"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                Examen de prueba agotado
                            </h5>
                            <p class="mb-0 opacity-90">
                                Ya utilizaste tu examen de prueba gratuito. Para seguir practicando y acceder a todos los simulacros, <strong>adquiere un plan</strong>.
                            </p>
                        </div>
                        <div class="flex-shrink-0">
                            <button type="button" class="btn btn-light fw-bold px-4"
                                    data-bs-toggle="modal" data-bs-target="#modalPlanes">
                                <i class="bi bi-star-fill me-2 text-warning"></i>Ver Planes
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm mb-4" style="background:linear-gradient(135deg,#fff3cd 0%,#ffe69c 100%);border-left:5px solid #ffc107 !important;">
                    <div class="card-body py-3 px-4 d-flex align-items-center gap-3 flex-wrap">
                        <i class="bi bi-hourglass-split text-warning fs-3 flex-shrink-0"></i>
                        <div class="flex-grow-1">
                            <strong class="text-dark">Modo de prueba</strong>
                            <span class="text-dark"> — tienes acceso a </span>
                            <strong class="text-dark">1 examen de 20 preguntas</strong>
                            <span class="text-muted"> (@(1 - examenesCompletados) restante(s))</span><br/>
                            <span class="small text-muted">Al finalizar tu prueba, adquiere un plan para acceso completo.</span>
                        </div>
                        <button type="button" class="btn btn-warning btn-sm fw-bold flex-shrink-0"
                                data-bs-toggle="modal" data-bs-target="#modalPlanes">
                            <i class="bi bi-star me-1"></i>Ver Planes
                        </button>
                    </div>
                </div>
            }
        }

        <!-- Banner suscripción vencida -->
        @if (suscripcionVencida)
        {
            <div class="card border-0 shadow mb-4" style="background:linear-gradient(135deg,#dc3545 0%,#a71d2a 100%);color:#fff;">
                <div class="card-body py-4 px-4 d-flex align-items-center gap-4 flex-wrap">
                    <div class="flex-shrink-0 text-center" style="min-width:60px">
                        <i class="bi bi-calendar-x-fill" style="font-size:3rem;opacity:.9"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="fw-bold mb-1">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Suscripción vencida
                        </h5>
                        <p class="mb-0 opacity-90">
                            Tu suscripción venció el <strong>@fechaVencimiento?.ToString("dd/MM/yyyy")</strong>.
                            Renuévala para seguir practicando con acceso completo.
                        </p>
                    </div>
                    <div class="flex-shrink-0">
                        <button type="button" class="btn btn-light fw-bold px-4"
                                data-bs-toggle="modal" data-bs-target="#modalPlanes">
                            <i class="bi bi-arrow-repeat me-2 text-danger"></i>Renovar Plan
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Banner próximo a vencer -->
        @if (proximoAVencer)
        {
            <div class="card border-0 shadow-sm mb-4" style="background:linear-gradient(135deg,#fff3cd 0%,#ffe69c 100%);border-left:5px solid #ffc107 !important;">
                <div class="card-body py-3 px-4 d-flex align-items-center gap-3 flex-wrap">
                    <i class="bi bi-calendar-warning-fill text-warning fs-3 flex-shrink-0"></i>
                    <div class="flex-grow-1">
                        <strong class="text-dark">Suscripción por vencer</strong>
                        <span class="text-dark"> — tu plan vence en </span>
                        <strong class="text-danger">@diasRestantes día(s)</strong>
                        <span class="text-muted"> (@fechaVencimiento?.ToString("dd/MM/yyyy"))</span><br/>
                        <span class="small text-muted">Renueva pronto para no perder el acceso.</span>
                    </div>
                    <button type="button" class="btn btn-warning btn-sm fw-bold flex-shrink-0"
                            data-bs-toggle="modal" data-bs-target="#modalPlanes">
                        <i class="bi bi-arrow-repeat me-1"></i>Renovar
                    </button>
                </div>
            </div>
        }

        <!-- Estadísticas -->
        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-journal-check text-primary fs-2 mb-2 d-block"></i>
                        <div class="fw-bold fs-3 text-primary">@totalExamenes</div>
                        <div class="text-muted small">Exámenes Realizados</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-trophy text-warning fs-2 mb-2 d-block"></i>
                        <div class="fw-bold fs-3 text-warning">@mejorPuntaje.ToString("0.0")%</div>
                        <div class="text-muted small">Mejor Puntaje</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm text-center h-100 @(intentosRest == 0 ? "border border-danger border-2" : "")">
                    <div class="card-body py-4">
                        <i class="bi bi-clock-history @(intentosRest == 0 ? "text-danger" : "text-success") fs-2 mb-2 d-block"></i>
                        <div class="fw-bold fs-3 @(intentosRest == 0 ? "text-danger" : "text-success")">
                            @intentosRest <span class="fs-6 fw-normal">/ 5</span>
                        </div>
                        <div class="text-muted small">Intentos restantes hoy</div>
                    </div>
                </div>
            </div>
        </div>

        @if (ViewBag.UltimoExamen != null)
        {
            var ult = ViewBag.UltimoExamen;
            <div class="alert alert-info d-flex align-items-center gap-3 mb-4">
                <i class="bi bi-info-circle-fill fs-4"></i>
                <div>
                    Último examen@(ult.TipoNombre != "" ? $" ({ult.TipoNombre})" : ""):
                    <strong>@ult.Puntaje / @ult.TotalPreguntas puntos</strong>
                    el @(((DateTime)ult.FechaFin).ToString("dd/MM/yyyy 'a las' HH:mm"))
                </div>
                <a asp-action="Historial" class="btn btn-sm btn-outline-primary ms-auto">
                    Ver historial
                </a>
            </div>
        }

        <!-- Gráfica de progreso personal -->
        @if (hayGrafica)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-graph-up me-2 text-primary"></i>Mi evolución — últimos exámenes
                    </h6>
                    <canvas id="graficaProgreso" height="100"></canvas>
                </div>
            </div>
        }

        <!-- Tipos de examen disponibles -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-mortarboard me-2 text-success"></i>Elige tu Tipo de Examen
            </h5>
            <a asp-action="Historial" class="btn btn-outline-success btn-sm">
                <i class="bi bi-clock-history me-1"></i>Mi Historial
            </a>
        </div>

        @if (!tiposAcceso.Any())
        {
            <div class="alert alert-warning text-center py-4">
                <i class="bi bi-exclamation-triangle fs-3 d-block mb-2"></i>
                <strong>Sin acceso asignado</strong>
                <p class="mb-0 mt-1 small">
                    El administrador aún no te ha asignado ningún tipo de examen.
                    Contáctalo para que configure tu acceso.
                </p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var tipo in tiposAcceso)
                {
                    var numPregs = pregsPorTipo.TryGetValue(tipo.Id, out var n) ? n : 0;
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100 action-card">
                            <div class="card-body p-4 d-flex flex-column text-center">
                                <i class="bi bi-mortarboard text-success mb-3" style="font-size:2.5rem"></i>
                                <h6 class="fw-bold mb-1">@tipo.Nombre</h6>
                                <p class="text-muted small mb-3 flex-grow-1">
                                    @numPregs pregunta(s) disponible(s)
                                </p>

                                @if (numPregs == 0)
                                {
                                    <button class="btn btn-outline-secondary btn-sm" disabled>
                                        Sin preguntas
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-success w-100 btn-iniciar"
                                            data-tipoid="@tipo.Id"
                                            data-nombre="@tipo.Nombre"
                                            data-disponibles="@numPregs"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalModoExamen">
                                        <i class="bi bi-play-fill me-2"></i>Iniciar Examen
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════
     Modal: Planes de suscripción (dinámico desde BD)
     ═══════════════════════════════════════════════════════ -->
@if (esTrial && planesSuscripcion.Any())
{
<div class="modal fade" id="modalPlanes" tabindex="-1" aria-labelledby="modalPlanesLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg overflow-hidden">

            <div class="modal-header border-0 text-white py-4 px-4"
                 style="background:linear-gradient(135deg,#6f42c1 0%,#0d6efd 100%)">
                <div>
                    <h4 class="modal-title fw-bold mb-1" id="modalPlanesLabel">
                        <i class="bi bi-star-fill me-2 text-warning"></i>Elige tu Plan
                    </h4>
                    <p class="mb-0 opacity-75 small">Accede a todos los simulacros y mejora tu puntaje SERUMS</p>
                </div>
                <button type="button" class="btn-close btn-close-white ms-auto"
                        data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body p-4">
                <div class="row g-4 justify-content-center">

                    @foreach (var plan in planesSuscripcion)
                    {
                        var colSize = planesSuscripcion.Count == 1 ? "col-12 col-md-8 col-lg-6"
                                    : planesSuscripcion.Count == 2 ? "col-12 col-md-6 col-lg-5"
                                    : "col-12 col-md-6 col-lg-4";
                        var cardScale = plan.EsPopular ? "transform:scale(1.03);" : "";
                        <div class="@colSize">
                            <div class="card h-100 border-0 shadow text-center overflow-hidden"
                                 style="border-top:5px solid @plan.ColorSecundario !important;@cardScale">
                                <div class="card-header border-0 py-3 position-relative"
                                     style="background:linear-gradient(135deg,@plan.ColorPrimario,@plan.ColorSecundario)">
                                    @if (plan.EsPopular)
                                    {
                                        <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-danger"
                                              style="font-size:.75rem">
                                            <i class="bi bi-fire me-1"></i>Más popular
                                        </span>
                                    }
                                    <h4 class="fw-bold text-white mb-0 @(plan.EsPopular ? "mt-2" : "")">@plan.Nombre</h4>
                                    <span class="badge text-white"
                                          style="background:rgba(255,255,255,.25);font-size:.8rem">@plan.Etiqueta</span>
                                </div>
                                <div class="card-body pt-3 pb-4 px-4">

                                    @if (!string.IsNullOrEmpty(plan.TextoBadge))
                                    {
                                        <div class="alert alert-warning py-2 px-3 mb-3 fw-bold small">
                                            <i class="bi bi-lightning-fill me-1"></i>
                                            @plan.TextoBadge
                                        </div>
                                    }

                                    <ul class="list-unstyled text-start mb-4 @(plan.EsPopular ? "mt-2" : "")">
                                        @foreach (var feat in plan.Caracteristicas.OrderBy(c => c.Orden))
                                        {
                                            <li class="d-flex align-items-start gap-2 mb-2">
                                                <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
                                                <span>@Html.Raw(System.Text.RegularExpressions.Regex.Replace(feat.Texto.Trim(), @"\*\*(.+?)\*\*", "<strong>$1</strong>"))</span>
                                            </li>
                                        }
                                    </ul>

                                    <div class="mb-4">
                                        <span class="text-muted small align-top" style="font-size:.9rem">S/</span>
                                        <span class="fw-bold" style="font-size:3.5rem;color:@plan.ColorSecundario;line-height:1">
                                            @plan.Precio.ToString("0")
                                        </span>
                                        <span class="text-muted small"> @plan.TextoPrecio</span>
                                    </div>

                                    @{
                                        var mensaje = $"Hola, me interesa el {plan.Nombre} de S/{plan.Precio.ToString("0")} {plan.TextoPrecio}. ¿Cómo puedo adquirirlo?";
                                        var baseUrl = plan.EnlaceBoton.Contains("wa.me") ? plan.EnlaceBoton.Split('?')[0] : plan.EnlaceBoton;
                                        var urlConMensaje = $"{baseUrl}?text={Uri.EscapeDataString(mensaje)}";
                                    }
                                    <a href="@urlConMensaje"
                                       class="btn w-100 fw-bold py-2 rounded-pill text-white"
                                       style="background:linear-gradient(135deg,@plan.ColorPrimario,@plan.ColorSecundario)"
                                       target="_blank" rel="noopener noreferrer">
                                        <i class="bi bi-whatsapp me-2"></i>@plan.TextoBoton
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>

            <div class="modal-footer border-0 justify-content-center py-3">
                <p class="text-muted small mb-0">
                    <i class="bi bi-shield-check text-success me-1"></i>
                    Pago seguro · Acceso inmediato · Sin permanencia
                </p>
            </div>
        </div>
    </div>
</div>
}

<!-- Modal: selección de modo de examen -->
<div class="modal fade" id="modalModoExamen" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-sliders me-2 text-success"></i>
                    Configurar Examen — <span id="modoNombreTipo"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <p class="text-muted small mb-3">Elige la cantidad de preguntas y la duración:</p>
                <div class="row g-3" id="modoOpciones">

                    <!-- Opción 20 -->
                    <div class="col-12">
                        <label class="d-block cursor-pointer modo-card" data-num="20">
                            <input type="radio" name="modoExamen" value="20" class="d-none" checked />
                            <div class="card border-2 border-success h-100 p-3 d-flex flex-row align-items-center gap-3">
                                <div class="text-success" style="font-size:2rem"><i class="bi bi-infinity"></i></div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">20 preguntas</div>
                                    <div class="text-muted small">Sin límite de tiempo — practica a tu ritmo</div>
                                </div>
                                <span class="badge bg-success">Seleccionado</span>
                            </div>
                        </label>
                    </div>

                    <!-- Opción 50 -->
                    <div class="col-12 modo-wrapper" id="wrapper50">
                        <label class="d-block cursor-pointer modo-card" data-num="50">
                            <input type="radio" name="modoExamen" value="50" class="d-none" />
                            <div class="card border-2 border-transparent h-100 p-3 d-flex flex-row align-items-center gap-3">
                                <div class="text-warning" style="font-size:2rem"><i class="bi bi-clock"></i></div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">50 preguntas</div>
                                    <div class="text-muted small">Tiempo límite: <strong>30 minutos</strong></div>
                                </div>
                            </div>
                        </label>
                    </div>

                    <!-- Opción 100 -->
                    <div class="col-12 modo-wrapper" id="wrapper100">
                        <label class="d-block cursor-pointer modo-card" data-num="100">
                            <input type="radio" name="modoExamen" value="100" class="d-none" />
                            <div class="card border-2 border-transparent h-100 p-3 d-flex flex-row align-items-center gap-3">
                                <div class="text-danger" style="font-size:2rem"><i class="bi bi-stopwatch-fill"></i></div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">100 preguntas</div>
                                    <div class="text-muted small">Tiempo límite: <strong>60 minutos</strong></div>
                                </div>
                            </div>
                        </label>
                    </div>

                </div>

                <div id="avisoPreguntas" class="alert alert-warning small mt-3 d-none">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <span id="avisoText"></span>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formIniciar" asp-action="IniciarExamen" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="inputTipoId"     name="tipoExamenId" value="0" />
                    <input type="hidden" id="inputNumPregs"   name="numPreguntas" value="20" />
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-play-fill me-2"></i>Comenzar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
<script>
    // Gráfica de progreso personal
    @if (hayGrafica)
    {
        <text>
    const ctx = document.getElementById('graficaProgreso').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(graficaFechas)),
            datasets: [{
                label: 'Puntaje (%)',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(graficaPorcentajes)),
                borderColor: '#0d6efd',
                backgroundColor: 'rgba(13,110,253,0.08)',
                borderWidth: 2,
                pointBackgroundColor: '#0d6efd',
                pointRadius: 5,
                fill: true,
                tension: 0.3
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ctx.parsed.y.toFixed(1) + '%'
                    }
                }
            },
            scales: {
                y: { min: 0, max: 100, ticks: { callback: v => v + '%' } }
            }
        }
    });
        </text>
    }

    // Poblar modal al abrir
    document.querySelectorAll('.btn-iniciar').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const tipoId     = this.dataset.tipoid;
            const nombre     = this.dataset.nombre;
            const disponibles = parseInt(this.dataset.disponibles);

            document.getElementById('modoNombreTipo').textContent = nombre;
            document.getElementById('inputTipoId').value = tipoId;

            // Mostrar/ocultar opciones según disponibilidad
            ['50', '100'].forEach(function (n) {
                const wrapper = document.getElementById('wrapper' + n);
                const num     = parseInt(n);
                const card    = wrapper.querySelector('.card');
                const radio   = wrapper.querySelector('input[type=radio]');
                if (disponibles < num) {
                    wrapper.style.opacity = '0.45';
                    wrapper.style.pointerEvents = 'none';
                    radio.disabled = true;
                    card.classList.add('border-secondary-subtle');
                } else {
                    wrapper.style.opacity = '';
                    wrapper.style.pointerEvents = '';
                    radio.disabled = false;
                }
            });

            // Aviso si hay pocas preguntas
            const aviso = document.getElementById('avisoPreguntas');
            const avisoText = document.getElementById('avisoText');
            const selNum = parseInt(document.querySelector('input[name="modoExamen"]:checked')?.value ?? '20');
            if (disponibles < selNum) {
                aviso.classList.remove('d-none');
                avisoText.textContent = 'Solo hay ' + disponibles + ' preguntas disponibles. El examen se realizará con todas ellas.';
            } else {
                aviso.classList.add('d-none');
            }

            // Reset selección a 20
            seleccionarModo(20);
        });
    });

    // Selección visual de modo
    function seleccionarModo(num) {
        document.querySelectorAll('.modo-card').forEach(function (lbl) {
            const n    = parseInt(lbl.dataset.num);
            const card = lbl.querySelector('.card');
            const badge = lbl.querySelector('.badge');
            const radio = lbl.querySelector('input[type=radio]');
            if (n === num) {
                radio.checked = true;
                card.className = card.className.replace('border-transparent', 'border-success');
                if (!badge) {
                    const b = document.createElement('span');
                    b.className = 'badge bg-success';
                    b.textContent = 'Seleccionado';
                    card.appendChild(b);
                }
            } else {
                radio.checked = false;
                card.className = card.className.replace('border-success', 'border-transparent');
                if (badge) badge.remove();
            }
        });
        document.getElementById('inputNumPregs').value = num;
    }

    document.querySelectorAll('.modo-card').forEach(function (lbl) {
        lbl.addEventListener('click', function () {
            if (this.querySelector('input[type=radio]')?.disabled) return;
            seleccionarModo(parseInt(this.dataset.num));
        });
    });

    // Auto-abrir modal de planes si trial agotado (una vez por sesión)
    @if (trialAgotado)
    {
        <text>
    if (!sessionStorage.getItem('planesModalMostrado')) {
        sessionStorage.setItem('planesModalMostrado', '1');
        setTimeout(function () {
            var modal = new bootstrap.Modal(document.getElementById('modalPlanes'));
            modal.show();
        }, 800);
    }
        </text>
    }
</script>
}

    </div>
</div>
