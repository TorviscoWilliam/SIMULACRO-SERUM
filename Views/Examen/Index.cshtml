@{
    ViewData["Title"] = "Inicio";
    var totalExamenes  = (int)ViewBag.TotalExamenes;
    var mejorPuntaje   = (double)ViewBag.MejorPuntaje;
    var totalPreguntas = (int)ViewBag.TotalPreguntas;
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <!-- Bienvenida -->
        <div class="card border-0 shadow-sm mb-4 bg-primary text-white">
            <div class="card-body py-4 px-4 d-flex align-items-center gap-4">
                <div class="welcome-icon">
                    <i class="bi bi-person-circle" style="font-size:4rem;opacity:.9"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1">¡Bienvenido, @User.Identity!.Name!</h3>
                    <p class="mb-0 opacity-75">
                        Practica con nuestro simulacro de examen. Cada intento es registrado
                        y podrás revisar tus respuestas al finalizar.
                    </p>
                </div>
            </div>
        </div>

        <!-- Estadísticas del usuario -->
        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-journal-check text-primary fs-2 mb-2 d-block"></i>
                        <div class="fw-bold fs-3 text-primary">@totalExamenes</div>
                        <div class="text-muted small">Exámenes Realizados</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-trophy text-warning fs-2 mb-2 d-block"></i>
                        <div class="fw-bold fs-3 text-warning">@mejorPuntaje.ToString("0.0")%</div>
                        <div class="text-muted small">Mejor Puntaje</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-question-circle text-success fs-2 mb-2 d-block"></i>
                        <div class="fw-bold fs-3 text-success">@totalPreguntas</div>
                        <div class="text-muted small">Preguntas Disponibles</div>
                    </div>
                </div>
            </div>
        </div>

        @if (ViewBag.UltimoExamen != null)
        {
            var ult = ViewBag.UltimoExamen;
            <div class="alert alert-info d-flex align-items-center gap-3 mb-4">
                <i class="bi bi-info-circle-fill fs-4"></i>
                <div>
                    Último examen: <strong>@ult.Puntaje / @ult.TotalPreguntas puntos</strong>
                    el @((DateTime)ult.FechaFin).ToString("dd/MM/yyyy 'a las' HH:mm")
                </div>
                <a asp-action="Historial" class="btn btn-sm btn-outline-primary ms-auto">
                    Ver historial
                </a>
            </div>
        }

        <!-- Acciones -->
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 action-card">
                    <div class="card-body p-4 text-center d-flex flex-column">
                        <i class="bi bi-play-circle-fill text-primary mb-3" style="font-size:3.5rem"></i>
                        <h5 class="fw-bold mb-2">Tomar Nuevo Examen</h5>
                        <p class="text-muted small mb-4 flex-grow-1">
                            El examen presenta preguntas en orden aleatorio con alternativas mezcladas.
                            Cada respuesta correcta vale 1 punto.
                        </p>

                        @if (totalPreguntas == 0)
                        {
                            <button class="btn btn-primary btn-lg" disabled>
                                <i class="bi bi-play-fill me-2"></i>Sin preguntas disponibles
                            </button>
                        }
                        else
                        {
                            <form asp-action="IniciarExamen" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary btn-lg w-100">
                                    <i class="bi bi-play-fill me-2"></i>¡Iniciar Examen!
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 action-card">
                    <div class="card-body p-4 text-center d-flex flex-column">
                        <i class="bi bi-clock-history text-success mb-3" style="font-size:3.5rem"></i>
                        <h5 class="fw-bold mb-2">Mi Historial</h5>
                        <p class="text-muted small mb-4 flex-grow-1">
                            Revisa todos tus intentos anteriores, ve qué preguntas fallaste
                            y cuál era la respuesta correcta.
                        </p>
                        <a asp-action="Historial" class="btn btn-outline-success btn-lg">
                            <i class="bi bi-clock-history me-2"></i>Ver Historial
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
