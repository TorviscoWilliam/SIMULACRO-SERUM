@model ConfiguracionViewModel
@{
    ViewData["Title"] = "Mi Configuración";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <h2 class="fw-bold mb-1"><i class="bi bi-gear me-2 text-primary"></i>Mi Configuración</h2>
        <p class="text-muted mb-4">Actualiza tu contraseña y tu nota ponderada.</p>

        <form asp-action="Configuracion" method="post">
            @Html.AntiForgeryToken()

            <!-- Cambio de contraseña -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0"><i class="bi bi-lock me-2 text-warning"></i>Cambiar Contraseña</h6>
                    <div class="text-muted small">Deja en blanco si no deseas cambiarla.</div>
                </div>
                <div class="card-body p-4">

                    <div class="mb-3">
                        <label asp-for="ContrasenaActual" class="form-label fw-semibold"></label>
                        <input asp-for="ContrasenaActual" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="ContrasenaActual" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContrasenaNueva" class="form-label fw-semibold"></label>
                        <input asp-for="ContrasenaNueva" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ContrasenaNueva" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="ConfirmarContrasena" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Nota ponderada -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0"><i class="bi bi-calculator me-2 text-success"></i>Nota Ponderada</h6>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-3">
                        Tu nota ponderada (0–20) se combina con tu puntaje de examen para calcular la
                        <strong>Nota Final</strong>:
                        <code>Nota Final = Puntaje Examen × 70% + Nota Ponderada × 30%</code>
                    </p>

                    <div class="mb-0">
                        <label asp-for="NotaPonderada" class="form-label fw-semibold"></label>
                        <div class="input-group" style="max-width:200px">
                            <input asp-for="NotaPonderada" type="number" step="0.01" min="0" max="20"
                                   class="form-control" placeholder="Ej: 15.5" />
                            <span class="input-group-text">/ 20</span>
                        </div>
                        <span asp-validation-for="NotaPonderada" class="text-danger small"></span>
                        <div class="form-text">Déjala en blanco para no usar nota ponderada.</div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary btn-lg flex-fill">
                    <i class="bi bi-floppy me-2"></i>Guardar cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left me-2"></i>Volver
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
