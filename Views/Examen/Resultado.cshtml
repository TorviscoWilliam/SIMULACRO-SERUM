@model ResultadoExamenViewModel
@{
    ViewData["Title"] = "Resultado del Examen";
    string badgeClass  = Model.Porcentaje >= 70 ? "bg-success" : Model.Porcentaje >= 50 ? "bg-warning" : "bg-danger";
    string iconClass   = Model.Porcentaje >= 70 ? "bi-trophy-fill text-warning" : Model.Porcentaje >= 50 ? "bi-emoji-neutral text-warning" : "bi-emoji-frown text-danger";
    string mensajeMain = Model.Porcentaje >= 70 ? "¡Excelente resultado!" : Model.Porcentaje >= 50 ? "Buen intento, sigue practicando" : "Sigue esforzándote";
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <!-- Resumen -->
        <div class="card border-0 shadow mb-4">
            <div class="card-body p-4 text-center">
                <i class="bi @iconClass mb-3 d-block" style="font-size:4rem"></i>
                <h2 class="fw-bold mb-1">@mensajeMain</h2>

                <!-- Puntaje grande -->
                <div class="my-4">
                    <span class="display-3 fw-bold">@Model.Puntaje</span>
                    <span class="fs-4 text-muted"> / @Model.TotalPreguntas</span>
                </div>

                <span class="badge @badgeClass fs-5 px-4 py-2 mb-4 rounded-pill">
                    @Model.Porcentaje.ToString("0.0")%
                </span>

                <!-- Detalles -->
                <div class="row g-3 mt-2">
                    <div class="col-sm-4">
                        <div class="bg-success-subtle rounded-3 p-3">
                            <div class="fw-bold fs-4 text-success">@Model.Puntaje</div>
                            <div class="small text-muted">Correctas</div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="bg-danger-subtle rounded-3 p-3">
                            <div class="fw-bold fs-4 text-danger">@(Model.TotalPreguntas - Model.Puntaje)</div>
                            <div class="small text-muted">Incorrectas</div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="bg-info-subtle rounded-3 p-3">
                            <div class="fw-bold fs-4 text-info">
                                @((int)Model.Duracion.TotalMinutes)m @(Model.Duracion.Seconds)s
                            </div>
                            <div class="small text-muted">Duración</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Acciones -->
        <div class="d-flex gap-3 mb-4">
            <form asp-action="IniciarExamen" method="post" class="flex-fill">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-arrow-repeat me-2"></i>Nuevo Examen
                </button>
            </form>
            <a asp-action="Historial" class="btn btn-outline-secondary btn-lg flex-fill">
                <i class="bi bi-clock-history me-2"></i>Ver Historial
            </a>
        </div>

        <!-- Revisión detallada -->
        <h5 class="fw-bold mb-3">
            <i class="bi bi-list-check me-2"></i>Revisión de Respuestas
        </h5>

        @foreach (var d in Model.Detalles)
        {
            <div class="card border-0 shadow-sm mb-2
                        @(d.EsCorrecta ? "border-start border-success border-3" : "border-start border-danger border-3")">
                <div class="card-body p-3">
                    <div class="d-flex gap-3">
                        <!-- Ícono -->
                        <div class="mt-1">
                            @if (d.EsCorrecta)
                            {
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                            }
                        </div>

                        <div class="flex-grow-1">
                            <!-- Número y pregunta -->
                            <div class="d-flex align-items-start justify-content-between mb-2">
                                <p class="fw-semibold mb-0 small">
                                    <span class="badge bg-secondary me-2">@d.Numero</span>
                                    @d.TextoPregunta
                                </p>
                                @if (d.EsCorrecta)
                                {
                                    <span class="badge bg-success ms-2">+1 pt</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger ms-2">0 pts</span>
                                }
                            </div>

                            @if (!d.EsCorrecta)
                            {
                                <!-- Tu respuesta (incorrecta) -->
                                <div class="mb-1">
                                    <span class="text-muted small">Tu respuesta: </span>
                                    @if (d.RespuestaSeleccionada != null)
                                    {
                                        <span class="text-danger small fw-semibold">
                                            <i class="bi bi-x me-1"></i>@d.RespuestaSeleccionada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">Sin responder</span>
                                    }
                                </div>
                                <!-- Respuesta correcta -->
                                <div>
                                    <span class="text-muted small">Respuesta correcta: </span>
                                    <span class="text-success small fw-semibold">
                                        <i class="bi bi-check me-1"></i>@d.RespuestaCorrecta
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div>
                                    <span class="text-success small fw-semibold">
                                        <i class="bi bi-check me-1"></i>@d.RespuestaCorrecta
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</div>
